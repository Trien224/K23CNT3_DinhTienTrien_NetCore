@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    var email = HttpContextAccessor.HttpContext.Session.GetString("AdminEmail");
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
</head>
<body>
    <div class="d-flex">
        <!-- Sidebar -->
        <nav class="sidebar p-3 bg-dark text-white flex-column" style="min-height:100vh; width:240px;">
            <h4 class="mb-4"><i class="bi bi-speedometer2"></i> Admin</h4>
            <ul class="nav flex-column">
               
                <li><a asp-area="Admin" asp-controller="Home" asp-action="Privacy" class="nav-link text-white">🏠 Trang chủ</a></li>

                <li><a asp-area="Admin" asp-controller="ChiTietHoaDons" asp-action="Index" class="nav-link text-white">📝 Chi tiết hóa đơn</a></li>
                <li><a asp-area="Admin" asp-controller="DanhGiaSanPhams" asp-action="Index" class="nav-link text-white">⭐ Đánh giá</a></li>
                <li><a asp-area="Admin" asp-controller="HoaDons" asp-action="Index" class="nav-link text-white">🧾 Hóa đơn</a></li>
                
                <li><a asp-area="Admin" asp-controller="KhachHangs" asp-action="Index" class="nav-link text-white">👥 Khách hàng</a></li>
                <li><a asp-area="Admin" asp-controller="LoaiSanPhams" asp-action="Index" class="nav-link text-white">📦 Loại sản phẩm</a></li>
                <li><a asp-area="Admin" asp-controller="MaGiamGiums" asp-action="Index" class="nav-link text-white">🎟️ Mã giảm giá</a></li>

                <li><a asp-area="Admin" asp-controller="QuanTriViens" asp-action="Index" class="nav-link text-white">🛡️ Quản trị viên</a></li>
                <li><a asp-area="Admin" asp-controller="SanPhams" asp-action="Index" class="nav-link text-white">📌 Sản phẩm</a></li>
                
                
            </ul>
        </nav>

        <!-- Main -->
        <div class="flex-grow-1 d-flex flex-column">
            <!-- Topbar -->
            <div class="bg-white border-bottom p-3 d-flex justify-content-between">
                @if (!string.IsNullOrEmpty(email))
                {
                    <span>@email</span>
                    <a asp-area="" asp-controller="AdminAccount" asp-action="Logout">Đăng xuất</a>
                }
            </div>

            <!-- Content -->
            <main class="p-3 flex-grow-1">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

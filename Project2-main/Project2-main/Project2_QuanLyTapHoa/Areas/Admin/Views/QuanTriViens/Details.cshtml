@model Project2_QuanLyTapHoa.Models.QuanTriVien

@{
    Layout = "_LogLayout";
    ViewData["Title"] = "Chi tiết quản trị viên";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 rounded-3">
                <div class="card-header bg-info text-white text-center">
                    <h4><i class="bi bi-person-badge me-2"></i> @ViewData["Title"]</h4>
                </div>
                <div class="card-body p-4">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 fw-bold"><i class="bi bi-person me-1"></i> Họ tên</dt>
                        <dd class="col-sm-8">@Model.HoTen</dd>

                        <dt class="col-sm-4 fw-bold"><i class="bi bi-envelope me-1"></i> Email</dt>
                        <dd class="col-sm-8">@Model.Email</dd>

                        <dt class="col-sm-4 fw-bold"><i class="bi bi-key me-1"></i> Mật khẩu</dt>
                        <dd class="col-sm-8">••••••••</dd> @* Không hiển thị mật khẩu thật *@

                        <dt class="col-sm-4 fw-bold"><i class="bi bi-telephone me-1"></i> Điện thoại</dt>
                        <dd class="col-sm-8">@Model.DienThoai</dd>

                        <dt class="col-sm-4 fw-bold"><i class="bi bi-geo-alt me-1"></i> Địa chỉ</dt>
                        <dd class="col-sm-8">@Model.DiaChi</dd>

                        <dt class="col-sm-4 fw-bold"><i class="bi bi-toggle-on me-1"></i> Trạng thái</dt>
                        <dd class="col-sm-8">
                            @if (Model.TrangThai)
                            {
                                <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i> Hoạt động</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary"><i class="bi bi-x-circle me-1"></i> Ngưng</span>
                            }
                        </dd>
                    </dl>
                </div>
                <div class="card-footer d-flex justify-content-end">
                    <a asp-action="Edit" asp-route-id="@Model?.MaQtv" class="btn btn-warning me-2">
                        <i class="bi bi-pencil-square"></i> Chỉnh sửa
                    </a>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> Quay lại
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

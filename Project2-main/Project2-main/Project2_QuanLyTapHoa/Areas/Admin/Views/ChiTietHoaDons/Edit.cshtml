@model Project2_QuanLyTapHoa.Models.ChiTietHoaDonDto

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg border-0 rounded-3">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"><i class="bi bi-pencil-square"></i> Sửa chi tiết hóa đơn</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="MaCthd" />

                        <div class="mb-3">
                            <label class="fw-bold"><i class="bi bi-receipt"></i> Hóa đơn</label>
                            <select asp-for="MaHd" class="form-control" asp-items="@(ViewData["MaHd"] as SelectList)" disabled></select>
                        </div>

                        <div class="mb-3">
                            <label class="fw-bold"><i class="bi bi-box-seam"></i> Sản phẩm</label>
                            <select asp-for="MaSp" class="form-control" asp-items="@(ViewData["MaSp"] as SelectList)" disabled></select>
                        </div>

                        <div class="mb-3">
                            <label asp-for="SoLuong" class="fw-bold"><i class="bi bi-plus-slash-minus"></i> Số lượng</label>
                            <input asp-for="SoLuong" class="form-control" id="SoLuong" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="DonGia" class="fw-bold"><i class="bi bi-cash-stack"></i> Đơn giá</label>
                            <input asp-for="DonGia" class="form-control" readonly />
                        </div>

                        <div class="mb-3">
                            <label asp-for="ThanhTien" class="fw-bold"><i class="bi bi-currency-exchange"></i> Thành tiền</label>
                            <input asp-for="ThanhTien" class="form-control" readonly />
                        </div>

                        <div class="text-end">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save"></i> Lưu
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary ms-2">
                                <i class="bi bi-arrow-left-circle"></i> Quay lại
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById("SoLuong").addEventListener("input", function () {
            var soLuong = parseFloat(this.value) || 0;
            var donGia = parseFloat(document.getElementById("DonGia").value) || 0;
            document.getElementById("ThanhTien").value = (soLuong * donGia).toFixed(2);
        });
    </script>
}

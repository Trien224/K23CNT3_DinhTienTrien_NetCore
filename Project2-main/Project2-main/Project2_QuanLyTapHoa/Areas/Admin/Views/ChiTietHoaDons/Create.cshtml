@model Project2_QuanLyTapHoa.Models.ChiTietHoaDonDto

@{
    ViewData["Title"] = "Thêm mới Chi tiết Hóa đơn";
}

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 rounded-3">
            <div class="card-header bg-warning text-white">
                <h4> <i class="bi bi-list-ul"></i>Thêm mới Chi tiết Hóa đơn</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        <div class="mb-3">
                            <label asp-for="MaHd" class="form-label fw-bold">
                                <i class="bi bi-file-text"></i> Hóa đơn
                            </label>
                            <select asp-for="MaHd" class="form-select" asp-items="@(ViewData["MaHd"] as SelectList)">
                                <option value="">-- Chọn hóa đơn --</option>
                            </select>
                            <span asp-validation-for="MaHd" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="MaSp" class="form-label fw-bold">
                                <i class="bi bi-box-seam"></i> Sản phẩm
                            </label>
                            <select asp-for="MaSp" class="form-select" asp-items="@(ViewData["MaSp"] as SelectList)" id="MaSp">
                                <option value="">-- Chọn sản phẩm --</option>
                            </select>
                            <span asp-validation-for="MaSp" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="SoLuong" class="form-label fw-bold">
                                <i class="bi bi-hash"></i> Số lượng
                            </label>
                            <input asp-for="SoLuong" class="form-control" id="SoLuong" />
                            <span asp-validation-for="SoLuong" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">
                                <i class="bi bi-cash"></i> Đơn giá
                            </label>
                            <input id="DonGia" class="form-control" readonly />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">
                                <i class="bi bi-coin"></i> Thành tiền
                            </label>
                            <input id="ThanhTien" class="form-control" readonly />
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Quay lại
                            </a>
                            <button type="submit" class="btn btn-warning">
                                <i class="bi bi-save"></i> Lưu
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

@section Scripts {
    <script>
        // Khi chọn sản phẩm -> gọi API lấy đơn giá
        $("#MaSp").change(function () {
            var spId = $(this).val();
            if (spId) {
                $.get("/SanPhams/GetDonGia", { id: spId }, function (data) {
                    $("#DonGia").val(data);
                    tinhThanhTien();
                });
            } else {
                $("#DonGia").val("");
                $("#ThanhTien").val("");
            }
        });

        // Khi thay đổi số lượng -> tính lại thành tiền
        $("#SoLuong").on("input", function () {
            tinhThanhTien();
        });

        // Hàm tính thành tiền
        function tinhThanhTien() {
            var sl = parseInt($("#SoLuong").val()) || 0;
            var gia = parseFloat($("#DonGia").val()) || 0;
            $("#ThanhTien").val(sl * gia);
        }
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

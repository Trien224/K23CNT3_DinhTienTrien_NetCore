@model Project2_QuanLyTapHoa.Models.KhachHang

@{
    Layout = "_LogLayout";
    ViewData["Title"] = "Chi tiết khách hàng";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg rounded-3">

                <!-- Header -->
                <div class="card-header bg-info text-white text-center">
                    <h4 class="mb-0">
                        <i class="bi bi-person-badge me-2"></i> @ViewData["Title"]
                    </h4>
                </div>

                <!-- Body -->
                <div class="card-body p-4">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 fw-bold"><i class="bi bi-person me-1"></i> Họ tên</dt>
                        <dd class="col-sm-8">@Model.HoTen</dd>

                        <dt class="col-sm-4 fw-bold"><i class="bi bi-envelope me-1"></i> Email</dt>
                        <dd class="col-sm-8">@Model.Email</dd>

                        <dt class="col-sm-4 fw-bold"><i class="bi bi-telephone me-1"></i> Điện thoại</dt>
                        <dd class="col-sm-8">@Model.DienThoai</dd>

                        <dt class="col-sm-4 fw-bold"><i class="bi bi-geo-alt me-1"></i> Địa chỉ</dt>
                        <dd class="col-sm-8">@Model.DiaChi</dd>

                        <dt class="col-sm-4 fw-bold"><i class="bi bi-key me-1"></i> Mật khẩu</dt>
                        <dd class="col-sm-8">****</dd>

                        <dt class="col-sm-4 fw-bold"><i class="bi bi-toggle-on me-1"></i> Trạng thái</dt>
                        <dd class="col-sm-8">
                            @if (Model.TrangThai)
                            {
                                <span class="badge bg-success">
                                    <i class="bi bi-check-circle me-1"></i> Hoạt động
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    <i class="bi bi-x-circle me-1"></i> Ngưng
                                </span>
                            }
                        </dd>
                    </dl>
                </div>

                <!-- Footer -->
                <div class="card-footer d-flex justify-content-end gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.MaKh" class="btn btn-warning text-white">
                        <i class="bi bi-pencil-square me-1"></i> Chỉnh sửa
                    </a>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Quay về
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

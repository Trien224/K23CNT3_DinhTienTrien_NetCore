@model Project2_QuanLyTapHoa.Models.DanhGiaSanPham

@{
    ViewData["Title"] = "Xóa đánh giá sản phẩm";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 rounded-3">
                <div class="card-header bg-danger text-white text-center">
                    <h4 class="mb-0"><i class="bi bi-exclamation-triangle"></i> Xác nhận xóa đánh giá sản phẩm</h4>
                </div>
                <div class="card-body p-4">
                    <p class="text-center text-muted mb-4">
                        Bạn có chắc chắn muốn xóa đánh giá này? Hành động này <strong>không thể hoàn tác</strong>.
                    </p>

                    <dl class="row mb-0">
                        <dt class="col-sm-4 fw-bold">Số sao</dt>
                        <dd class="col-sm-8">@Model.SoSao</dd>

                        <dt class="col-sm-4 fw-bold">Nội dung</dt>
                        <dd class="col-sm-8">@Model.NoiDung</dd>

                        <dt class="col-sm-4 fw-bold">Yêu thích</dt>
                        <dd class="col-sm-8">
                            @if (Model.LaYeuThich)
                            {
                                <span class="badge bg-success">Yêu thích</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Không</span>
                            }
                        </dd>

                        <dt class="col-sm-4 fw-bold">Ngày tạo</dt>
                        <dd class="col-sm-8">@Model.NgayTao.ToString("dd/MM/yyyy HH:mm")</dd>

                        <dt class="col-sm-4 fw-bold">Trạng thái</dt>
                        <dd class="col-sm-8">
                            @if (Model.TrangThai)
                            {
                                <span class="badge bg-success">Ẩn</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Hiện</span>
                            }
                        </dd>

                        <dt class="col-sm-4 fw-bold">Khách hàng</dt>
                        <dd class="col-sm-8">@Model.MaKhNavigation?.HoTen</dd>

                        <dt class="col-sm-4 fw-bold">Sản phẩm</dt>
                        <dd class="col-sm-8">@Model.MaSpNavigation?.TenSp</dd>
                    </dl>
                </div>
                <div class="card-footer d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> Quay lại
                    </a>
                    <form asp-action="Delete" method="post" class="d-inline">
                        <input type="hidden" asp-for="MaDanhGia" />
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash"></i> Xóa
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

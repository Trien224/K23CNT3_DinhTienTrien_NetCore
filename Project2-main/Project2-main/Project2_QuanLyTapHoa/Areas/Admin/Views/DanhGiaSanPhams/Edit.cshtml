@model Project2_QuanLyTapHoa.Models.DanhGiaUpdateTrangThaiDto

@{
    ViewData["Title"] = "Sửa trạng thái đánh giá";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg border-0 rounded-3">
                <div class="card-header bg-warning text-white">
                    <h4 class="mb-0"><i class="bi bi-pencil-square"></i> @ViewData["Title"]</h4>
                </div>
                <div class="card-body p-4">
                    <form id="editForm">
                        <input type="hidden" asp-for="MaDanhGia" id="MaDanhGia" />

                        <div class="mb-3">
                            <label asp-for="TrangThai" class="form-label fw-bold">
                                <i class="bi bi-toggle-on"></i> Trạng thái
                            </label>
                            <select asp-for="TrangThai" class="form-select" id="TrangThai">
                                <option value="true" selected="@(Model.TrangThai ? "selected" : null)">✔ Hiển thị</option>
                                <option value="false" selected="@(Model.TrangThai ? null : "selected")">🚫 Ẩn</option>
                            </select>
                        </div>

                        <div class="text-end">
                            <button type="button" id="btnSave" class="btn btn-primary">
                                <i class="bi bi-save"></i> Lưu
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary ms-2">
                                <i class="bi bi-arrow-left-circle"></i> Quay lại
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        $("#btnSave").click(function () {
            var formData = {
                MaDanhGia: $("#MaDanhGia").val(),
                TrangThai: $("#TrangThai").val() === "true"
            };

            $.ajax({
                url: '@Url.Action("Edit", "DanhGiaSanPhams")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(formData),
                success: function (res) {
                    if (res.success) {
                        Swal.fire({
                            icon: "success",
                            title: "Cập nhật thành công",
                            text: res.message,
                            confirmButtonColor: "#3085d6"
                        }).then(() => {
                            window.location.href = '@Url.Action("Index", "DanhGiaSanPhams")';
                        });
                    } else {
                        Swal.fire("Lỗi", res.message, "error");
                    }
                },
                error: function () {
                    Swal.fire("Lỗi", "Có lỗi xảy ra khi gửi dữ liệu.", "error");
                }
            });
        });
    </script>
}

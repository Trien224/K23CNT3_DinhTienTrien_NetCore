@model Project2_QuanLyTapHoa.Models.DanhGiaSanPhamDto

<div class="container d-flex justify-content-center" style="min-height: 100vh;">
    <div class="card shadow-lg rounded-3" style="max-width: 600px; width: 100%;">
        <div class="card-header bg-warning text-white">
            <h4 class="mb-0">
                <i class="bi bi-star-half"></i> Tạo Đánh giá
            </h4>
        </div>
        <div class="card-body">
            <form id="createForm">
                <!-- Khách hàng -->
                <div class="mb-3">
                    <label asp-for="MaKh" class="form-label fw-bold">
                        <i class="bi bi-person"></i> Khách hàng
                    </label>
                    <select asp-for="MaKh" class="form-select" asp-items="ViewBag.MaKh" id="MaKh">
                        <option value="">-- Chọn khách hàng --</option>
                    </select>
                </div>

                <!-- Sản phẩm -->
                <div class="mb-3">
                    <label asp-for="MaSp" class="form-label fw-bold">
                        <i class="bi bi-box-seam"></i> Sản phẩm
                    </label>
                    <select asp-for="MaSp" class="form-select" asp-items="ViewBag.MaSp" id="MaSp">
                        <option value="">-- Chọn sản phẩm --</option>
                    </select>
                </div>

                <!-- Số sao -->
                <div class="mb-3">
                    <label asp-for="SoSao" class="form-label fw-bold">
                        <i class="bi bi-star"></i> Đánh giá sao
                    </label>
                    <div id="starRating" class="d-flex gap-2 fs-3 text-warning cursor-pointer">
                        <i class="bi bi-star" data-value="1"></i>
                        <i class="bi bi-star" data-value="2"></i>
                        <i class="bi bi-star" data-value="3"></i>
                        <i class="bi bi-star" data-value="4"></i>
                        <i class="bi bi-star" data-value="5"></i>
                    </div>
                    <input type="hidden" id="SoSao" name="SoSao" />
                </div>

                <!-- Nội dung -->
                <div class="mb-3">
                    <label asp-for="NoiDung" class="form-label fw-bold">
                        <i class="bi bi-chat-dots"></i> Nội dung
                    </label>
                    <textarea asp-for="NoiDung" class="form-control" rows="3" id="NoiDung" placeholder="Nhập nội dung đánh giá..."></textarea>
                </div>

                <!-- Yêu thích -->
                <div class="form-check mb-3">
                    <input class="form-check-input" asp-for="LaYeuThich" id="LaYeuThich" />
                    <label class="form-check-label fw-bold" for="LaYeuThich">
                        <i class="bi bi-heart"></i> Đánh dấu yêu thích
                    </label>
                </div>

                <!-- Trạng thái -->
                <div class="mb-3">
                    <label asp-for="TrangThai" class="form-label fw-bold">
                        <i class="bi bi-eye"></i> Trạng thái
                    </label>
                    <select asp-for="TrangThai" class="form-select" id="TrangThai">
                        <option value="true">Hiển thị</option>
                        <option value="false">Ẩn</option>
                    </select>
                </div>

                <!-- Buttons -->
                <div class="text-end">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Quay lại
                    </a>
                    <button type="submit" class="btn btn-warning">
                        <i class="bi bi-save"></i> Lưu
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // ⭐ Xử lý chọn sao
            $("#starRating i").on("mouseenter", function () {
                var hoverValue = $(this).data("value");
                highlightStars(hoverValue);
            });

            $("#starRating").on("mouseleave", function () {
                var rating = $("#SoSao").val() || 0;
                highlightStars(rating);
            });

            $("#starRating i").on("click", function () {
                var rating = $(this).data("value");
                $("#SoSao").val(rating);
                highlightStars(rating);
            });

            function highlightStars(count) {
                $("#starRating i").removeClass("bi-star-fill").addClass("bi-star");
                $("#starRating i").each(function () {
                    if ($(this).data("value") <= count) {
                        $(this).removeClass("bi-star").addClass("bi-star-fill");
                    }
                });
            }

            // ⭐ Submit form
            $("#createForm").on("submit", function (e) {
                e.preventDefault();

                var formData = {
                    MaKh: parseInt($("#MaKh").val()) || null,
                    MaSp: parseInt($("#MaSp").val()) || null,
                    SoSao: parseInt($("#SoSao").val()) || null,
                    NoiDung: $("#NoiDung").val(),
                    LaYeuThich: $("#LaYeuThich").is(":checked"),
                    TrangThai: $("#TrangThai").val() === "true"
                };

                if (!formData.MaKh || !formData.MaSp || !formData.SoSao) {
                    Swal.fire("Thiếu dữ liệu", "Vui lòng chọn khách hàng, sản phẩm và số sao!", "warning");
                    return;
                }

                $.ajax({
                    url: '@Url.Action("Create", "DanhGiaSanPhams")',
                    type: "POST",
                    contentType: "application/json; charset=utf-8",
                    data: JSON.stringify(formData),
                    beforeSend: function () {
                        $("#createForm button[type=submit]").prop("disabled", true);
                    },
                    warning: function (res) {
                        if (res.warning) {
                            Swal.fire("Thành công", res.message, "warning").then(() => {
                                window.location.href = '@Url.Action("Index", "DanhGiaSanPhams")';
                            });
                        } else {
                            Swal.fire("Lỗi", res.message || "Không thể lưu dữ liệu", "error");
                        }
                    },
                    error: function () {
                        Swal.fire("Lỗi", "Có lỗi xảy ra khi lưu dữ liệu!", "error");
                    },
                    complete: function () {
                        $("#createForm button[type=submit]").prop("disabled", false);
                    }
                });
            });
        });
    </script>
}

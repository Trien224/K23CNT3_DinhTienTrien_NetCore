@model Project2_QuanLyTapHoa.Models.MaGiamGium

@{
    Layout = "_LogLayout";
    ViewData["Title"] = "Thêm mã giảm giá";
}
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg border-0 rounded-3">
                <div class="card-header bg-success text-white">
                    <h4><i class="bi bi-ticket-perforated"></i> Thêm mã giảm giá</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="MaVoucher" class="form-label fw-bold">
                                <i class="bi bi-upc-scan"></i> Mã Voucher
                            </label>
                            <input asp-for="MaVoucher" class="form-control" placeholder="Nhập mã voucher..." />
                            <span asp-validation-for="MaVoucher" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="TenVoucher" class="form-label fw-bold">
                                <i class="bi bi-card-heading"></i> Tên Voucher
                            </label>
                            <input asp-for="TenVoucher" class="form-control" placeholder="Nhập tên voucher..." />
                            <span asp-validation-for="TenVoucher" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="MoTa" class="form-label fw-bold">
                                <i class="bi bi-text-paragraph"></i> Mô tả
                            </label>
                            <textarea asp-for="MoTa" class="form-control" rows="3" placeholder="Mô tả chi tiết..."></textarea>
                            <span asp-validation-for="MoTa" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="DaSuDung" class="form-label fw-bold">
                                <i class="bi bi-check2-circle"></i> Đã sử dụng
                            </label>
                            <input asp-for="DaSuDung" type="number" class="form-control" />
                            <span asp-validation-for="DaSuDung" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NgayBatDau" class="form-label fw-bold">
                                <i class="bi bi-calendar-date"></i> Ngày bắt đầu
                            </label>
                            <input asp-for="NgayBatDau" type="date" class="form-control" />
                            <span asp-validation-for="NgayBatDau" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NgayKetThuc" class="form-label fw-bold">
                                <i class="bi bi-calendar2-check"></i> Ngày kết thúc
                            </label>
                            <input asp-for="NgayKetThuc" type="date" class="form-control" />
                            <span asp-validation-for="NgayKetThuc" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Quay lại
                            </a>
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-plus-circle"></i> Tạo mới
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

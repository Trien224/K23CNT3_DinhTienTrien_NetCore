@model Project2_QuanLyTapHoa.Models.MaGiamGium

@{
    Layout = "_LogLayout";
    ViewData["Title"] = "Xóa Mã giảm giá";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 rounded-3">
                <div class="card-header bg-danger text-white text-center">
                    <h4><i class="bi bi-exclamation-triangle"></i> Xác nhận xóa mã giảm giá</h4>
                </div>
                <div class="card-body p-4">
                    <p class="text-center text-muted mb-4">
                        Bạn có chắc chắn muốn xóa mã giảm giá này không? Hành động này không thể hoàn tác.
                    </p>

                    <div class="row">
                        <div class="col-md-4 text-center">
                            @* Icon voucher *@
                            <i class="bi bi-ticket-perforated" style="font-size:6rem;color:#dc3545;"></i>
                        </div>
                        <div class="col-md-8">
                            <dl class="row">
                                <dt class="col-sm-4 fw-bold">Tên voucher</dt>
                                <dd class="col-sm-8">@Model.TenVoucher</dd>

                                <dt class="col-sm-4 fw-bold">Mô tả</dt>
                                <dd class="col-sm-8">@Model.MoTa</dd>

                                <dt class="col-sm-4 fw-bold">Giảm %</dt>
                                <dd class="col-sm-8">@((Model.PhanTramGiam > 0) ? $"{Model.PhanTramGiam} %" : "Không")</dd>

                                <dt class="col-sm-4 fw-bold">Giảm tiền trực tiếp</dt>
                                <dd class="col-sm-8">@String.Format("{0:N0} ₫", Model.GiamTienTrucTiep)</dd>

                                <dt class="col-sm-4 fw-bold">Giá trị đơn tối thiểu</dt>
                                <dd class="col-sm-8">@String.Format("{0:N0} ₫", Model.GiaTriDonToiThieu)</dd>

                                <dt class="col-sm-4 fw-bold">Số lượng</dt>
                                <dd class="col-sm-8">@Model.SoLuong</dd>

                                <dt class="col-sm-4 fw-bold">Đã sử dụng</dt>
                                <dd class="col-sm-8">@Model.DaSuDung</dd>

                                <dt class="col-sm-4 fw-bold">Ngày bắt đầu</dt>
                                <dd class="col-sm-8">@Model.NgayBatDau.ToString("dd/MM/yyyy")</dd>

                                <dt class="col-sm-4 fw-bold">Ngày kết thúc</dt>
                                <dd class="col-sm-8">@Model.NgayKetThuc.ToString("dd/MM/yyyy")</dd>

                                <dt class="col-sm-4 fw-bold">Trạng thái</dt>
                                <dd class="col-sm-8">
                                    @if (Model.TrangThai)
                                    {
                                        <span class="badge bg-success">Hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Ngưng hoạt động</span>
                                    }
                                </dd>
                            </dl>
                        </div>
                    </div>
                </div>
                <div class="card-footer d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> Quay lại
                    </a>
                    <form asp-action="Delete" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="MaVoucher" />
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash"></i> Xóa
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

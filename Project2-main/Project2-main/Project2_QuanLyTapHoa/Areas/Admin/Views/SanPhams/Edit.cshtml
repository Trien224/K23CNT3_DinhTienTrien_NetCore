@model Project2_QuanLyTapHoa.Models.SanPhamDto

@{
    Layout = "_LogLayout";
    ViewData["Title"] = "Chỉnh sửa sản phẩm";
}

<div class="container d-flex justify-content-center align-items-center" style="min-height: 100vh;">
    <div class="card shadow-lg border-0 rounded-3" style="max-width: 700px; width: 100%;">
        <div class="card-header bg-warning text-white">
            <h4 class="mb-0"><i class="bi bi-pencil-square"></i> @ViewData["Title"]</h4>
        </div>
        <div class="card-body p-4">
            <form id="editForm" enctype="multipart/form-data">
                <!-- hidden ID -->
                <input type="hidden" asp-for="MaSp" name="MaSp" />

                <!-- Tên sản phẩm -->
                <div class="mb-3">
                    <label asp-for="TenSp" class="form-label fw-bold">
                        <i class="bi bi-tag"></i> Tên sản phẩm
                    </label>
                    <input asp-for="TenSp" name="TenSp" class="form-control" placeholder="Nhập tên sản phẩm..." />
                    <span asp-validation-for="TenSp" class="text-danger"></span>
                </div>

                <!-- Mô tả -->
                <div class="mb-3">
                    <label asp-for="MoTa" class="form-label fw-bold">
                        <i class="bi bi-textarea-resize"></i> Mô tả
                    </label>
                    <textarea asp-for="MoTa" name="MoTa" class="form-control" rows="3" placeholder="Nhập mô tả sản phẩm..."></textarea>
                    <span asp-validation-for="MoTa" class="text-danger"></span>
                </div>

                <!-- Đơn giá -->
                <div class="mb-3">
                    <label asp-for="DonGia" class="form-label fw-bold">
                        <i class="bi bi-currency-dollar"></i> Đơn giá
                    </label>
                    <input asp-for="DonGia" name="DonGia" class="form-control" type="number" min="0" />
                    <span asp-validation-for="DonGia" class="text-danger"></span>
                </div>

                <!-- Số lượng -->
                <div class="mb-3">
                    <label asp-for="SoLuong" class="form-label fw-bold">
                        <i class="bi bi-box"></i> Số lượng
                    </label>
                    <input asp-for="SoLuong" name="SoLuong" class="form-control" type="number" min="0" />
                    <span asp-validation-for="SoLuong" class="text-danger"></span>
                </div>

                <!-- Ảnh hiện tại -->
                <div class="mb-3">
                    <label class="form-label fw-bold"><i class="bi bi-image"></i> Ảnh hiện tại</label><br />
                    @if (!string.IsNullOrEmpty(Model.HinhAnh))
                    {
                        <img id="previewOld" src="@Model.HinhAnh" alt="Ảnh sản phẩm" width="150" class="mb-2 border rounded p-1" />
                    }
                    else
                    {
                        <p class="text-muted">(Chưa có ảnh)</p>
                    }
                    <input type="hidden" name="HinhAnh" value="@Model.HinhAnh" />
                </div>

                <!-- Upload ảnh mới -->
                <div class="mb-3">
                    <label class="form-label fw-bold"><i class="bi bi-upload"></i> Chọn ảnh mới (nếu có)</label>
                    <input type="file" name="file" id="fileInput" class="form-control" accept="image/*" />
                    <img id="previewNew" src="#" alt="Preview ảnh mới" width="150" class="d-none mt-2 border rounded p-1" />
                </div>

                <!-- Loại sản phẩm -->
                <div class="mb-3">
                    <label asp-for="MaLoai" class="form-label fw-bold"><i class="bi bi-diagram-3"></i> Loại sản phẩm</label>
                    <select asp-for="MaLoai" name="MaLoai" class="form-control" asp-items="ViewBag.MaLoai"></select>
                    <span asp-validation-for="MaLoai" class="text-danger"></span>
                </div>

                <!-- Giảm giá -->
                <div class="mb-3">
                    <label asp-for="PhanTramGiam" class="form-label fw-bold"><i class="bi bi-percent"></i> Giảm giá (%)</label>
                    <input asp-for="PhanTramGiam" name="PhanTramGiam" class="form-control" type="number" min="0" max="100" />
                    <span asp-validation-for="PhanTramGiam" class="text-danger"></span>
                </div>

                <!-- Trạng thái -->
                <div class="form-check mb-3">
                    <input class="form-check-input" asp-for="TrangThai" name="TrangThai" />
                    <label class="form-check-label fw-bold" asp-for="TrangThai">
                        <i class="bi bi-toggle-on"></i> Trạng thái
                    </label>
                </div>

                <!-- Nút hành động -->
                <div class="text-end">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save"></i> Lưu thay đổi
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary ms-2">
                        <i class="bi bi-arrow-left"></i> Quay lại
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Preview ảnh mới khi chọn
        $("#fileInput").change(function () {
            var reader = new FileReader();
            reader.onload = function (e) {
                $("#previewNew").attr("src", e.target.result).removeClass("d-none");
            };
            if (this.files && this.files[0]) {
                reader.readAsDataURL(this.files[0]);
            }
        });

        // Submit bằng AJAX
        $("#editForm").submit(function (e) {
            e.preventDefault();

            var formData = new FormData(this);

            $.ajax({
                url: '@Url.Action("EditAjax", "SanPhams")',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function (res) {
                    if (res.success) {
                        Swal.fire({
                            icon: "success",
                            title: "Thành công",
                            text: res.message,
                            confirmButtonColor: "#3085d6"
                        }).then(() => {
                            window.location.href = '@Url.Action("Index", "SanPhams")';
                        });
                    } else {
                        Swal.fire("Lỗi", res.message, "error");
                    }
                },
                error: function () {
                    Swal.fire("Lỗi", "⚠ Có lỗi xảy ra khi gửi dữ liệu.", "error");
                }
            });
        });
    </script>
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

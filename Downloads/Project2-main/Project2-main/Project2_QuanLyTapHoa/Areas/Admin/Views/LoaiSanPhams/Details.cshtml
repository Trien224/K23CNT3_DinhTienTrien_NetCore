@model Project2_QuanLyTapHoa.Models.LoaiSanPham

@{
    Layout = "_LogLayout";
    ViewData["Title"] = "Chi tiết loại sản phẩm";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg rounded-3">
                <!-- Header -->
                <div class="card-header bg-info text-white text-center">
                    <h4 class="mb-0">
                        <i class="bi bi-tags-fill"></i>@ViewData["Title"]
                    </h4>
                </div>

                <!-- Body -->
                <div class="card-body p-4">
                    <dl class="row mb-0">
                        <!-- Tên loại -->
                        <dt class="col-sm-4 fw-bold">
                            <i class="bi bi-tag me-1"></i> Tên loại
                        </dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.TenLoai)</dd>

                        <!-- Mô tả -->
                        <dt class="col-sm-4 fw-bold">
                            <i class="bi bi-card-text me-1"></i> Mô tả
                        </dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.MoTa)</dd>

                        <!-- Trạng thái -->
                        <dt class="col-sm-4 fw-bold">
                            <i class="bi bi-toggle-on me-1"></i> Trạng thái
                        </dt>
                        <dd class="col-sm-8">
                            @if (Model.TrangThai)
                            {
                                <span class="badge bg-success">
                                    <i class="bi bi-check-circle me-1"></i> Hoạt động
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    <i class="bi bi-x-circle me-1"></i> Ngưng
                                </span>
                            }
                        </dd>
                    </dl>
                </div>

                <!-- Footer -->
                <div class="card-footer d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Quay lại
                    </a>
                    <a asp-action="Edit" asp-route-id="@Model?.MaLoai" class="btn btn-warning text-white">
                        <i class="bi bi-pencil-square me-1"></i> Sửa
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

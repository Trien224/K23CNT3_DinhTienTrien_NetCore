@model IEnumerable<Project2_QuanLyTapHoa.Models.ChiTietHoaDon>

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Danh sách chi tiết hóa đơn";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">
            <i class="bi bi-list-ul"></i> @ViewData["Title"]
        </h2>
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Thêm mới
        </a>
    </div>

    <div class="card shadow border-0 rounded-3">
        <div class="card-body p-0">
            <table class="table table-hover table-striped mb-0 align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Số lượng</th>
                        <th>Đơn giá</th>
                        <th>Thành tiền</th>
                        <th>Hóa đơn</th>
                        <th>Sản phẩm</th>
                        <th class="text-center">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.SoLuong</td>
                            <td>@String.Format("{0:N0} ₫", item.DonGia)</td>
                            <td class="fw-bold text-danger">@String.Format("{0:N0} ₫", item.ThanhTien)</td>
                            <td>
                                <span class="badge bg-secondary">HD-@item.MaHdNavigation?.MaHd</span>
                                <div class="small text-muted">
                                    @item.MaHdNavigation?.MaKhNavigation?.HoTen
                                </div>
                            </td>
                            <td>@item.MaSpNavigation?.TenSp</td>
                            <td class="text-center">
                                <a asp-action="Edit" asp-route-id="@item.MaCthd"
                                   class="btn btn-sm btn-warning me-1" title="Chỉnh sửa">
                                    <i class="bi bi-pencil-square"></i> Sửa
                                </a>
                                <a asp-action="Details" asp-route-id="@item.MaCthd"
                                   class="btn btn-sm btn-info text-white me-1" title="Chi tiết">
                                    <i class="bi bi-eye"></i> Xem
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.MaCthd"
                                   class="btn btn-sm btn-danger" title="Xóa">
                                    <i class="bi bi-trash"></i> Xóa
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

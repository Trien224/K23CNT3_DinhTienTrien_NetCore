@model Project2_QuanLyTapHoa.Models.ChiTietHoaDon

@{
    ViewData["Title"] = "Chi tiết hóa đơn";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg rounded-3">

                <!-- Header -->
                <div class="card-header bg-info text-white text-center">
                    <h4 class="mb-0">
                        <i class="bi bi-list-ul"></i> @ViewData["Title"]
                    </h4>
                </div>

                <!-- Body -->
                <div class="card-body p-4">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 fw-bold">
                            <i class="bi bi-hash me-1"></i> Mã chi tiết
                        </dt>
                        <dd class="col-sm-8">@Model.MaCthd</dd>

                        <dt class="col-sm-4 fw-bold">
                            <i class="bi bi-box-seam me-1"></i> Số lượng
                        </dt>
                        <dd class="col-sm-8">@Model.SoLuong</dd>

                        <dt class="col-sm-4 fw-bold">
                            <i class="bi bi-currency-dollar me-1"></i> Đơn giá
                        </dt>
                        <dd class="col-sm-8">@Model.DonGia.ToString("N0") đ</dd>

                        <dt class="col-sm-4 fw-bold">
                            <i class="bi bi-calculator me-1"></i> Thành tiền
                        </dt>
                        <dd class="col-sm-8">@Model.ThanhTien.ToString("N0") đ</dd>

                        <dt class="col-sm-4 fw-bold">
                            <i class="bi bi-file-text me-1"></i> Hóa đơn
                        </dt>
                        <dd class="col-sm-8">
                            @Model.MaHdNavigation?.MaHd
                            (Ngày lập: @Model.MaHdNavigation?.NgayLap.ToString("dd/MM/yyyy"))
                        </dd>

                        <dt class="col-sm-4 fw-bold">
                            <i class="bi bi-bag me-1"></i> Sản phẩm
                        </dt>
                        <dd class="col-sm-8">
                            @Model.MaSpNavigation?.TenSp
                        </dd>
                    </dl>
                </div>

                <!-- Footer -->
                <div class="card-footer d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Quay lại
                    </a>
                    <a asp-action="Edit" asp-route-id="@Model.MaCthd" class="btn btn-warning text-white">
                        <i class="bi bi-pencil-square me-1"></i> Sửa
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

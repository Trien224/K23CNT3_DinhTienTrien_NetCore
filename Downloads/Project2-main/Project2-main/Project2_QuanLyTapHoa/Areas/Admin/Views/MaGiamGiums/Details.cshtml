@model Project2_QuanLyTapHoa.Models.MaGiamGium

@{
    Layout = "_LogLayout";
    ViewData["Title"] = "Chi tiết voucher";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg rounded-3">

                <!-- Header -->
                <div class="card-header bg-info text-white text-center">
                    <h4 class="mb-0"><i class="bi bi-ticket-perforated me-2"></i> @ViewData["Title"]</h4>
                </div>

                <!-- Body -->
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 fw-bold"><i class="bi bi-tag me-1"></i> Tên voucher</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.TenVoucher)</dd>

                        <dt class="col-sm-4 fw-bold"><i class="bi bi-journal-text me-1"></i> Mô tả</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.MoTa)</dd>

                        <dt class="col-sm-4 fw-bold"><i class="bi bi-percent me-1"></i> Giảm (%)</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.PhanTramGiam)</dd>

                        <dt class="col-sm-4 fw-bold"><i class="bi bi-currency-dollar me-1"></i> Giảm tiền trực tiếp</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.GiamTienTrucTiep)</dd>

                        <dt class="col-sm-4 fw-bold"><i class="bi bi-wallet2 me-1"></i> Giá trị tối thiểu</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.GiaTriDonToiThieu)</dd>

                        <dt class="col-sm-4 fw-bold"><i class="bi bi-stack me-1"></i> Số lượng</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.SoLuong)</dd>

                        <dt class="col-sm-4 fw-bold"><i class="bi bi-check2-square me-1"></i> Đã sử dụng</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.DaSuDung)</dd>

                        <dt class="col-sm-4 fw-bold"><i class="bi bi-calendar-event me-1"></i> Ngày bắt đầu</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.NgayBatDau)</dd>

                        <dt class="col-sm-4 fw-bold"><i class="bi bi-calendar-event me-1"></i> Ngày kết thúc</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.NgayKetThuc)</dd>

                        <dt class="col-sm-4 fw-bold"><i class="bi bi-toggle-on me-1"></i> Trạng thái</dt>
                        <dd class="col-sm-8">
                            @if (Model.TrangThai)
                            {
                                <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i> Hoạt động</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary"><i class="bi bi-x-circle me-1"></i> Ngưng</span>
                            }
                        </dd>
                    </dl>
                </div>

                <!-- Footer -->
                <div class="card-footer d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Quay lại
                    </a>
                    <a asp-action="Edit" asp-route-id="@Model.MaVoucher" class="btn btn-warning text-white">
                        <i class="bi bi-pencil-square me-1"></i> Chỉnh sửa
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

@model IEnumerable<Project2_QuanLyTapHoa.Models.SanPham>

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Danh sách sản phẩm";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">
            📌 @ViewData["Title"]
        </h2>
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Thêm sản phẩm
        </a>
    </div>

    <div class="card shadow border-0 rounded-3">
        <div class="card-body p-0">
            <table class="table table-hover table-striped mb-0 align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Sản phẩm</th>
                        <th>Mô tả</th>
                        <th>Đơn giá</th>
                        <th>Số lượng</th>
                        <th>Hình ảnh</th>
                        <th>Phần trăm</th>
                        <th>Trạng thái</th>
                        <th>Mã loại</th>
                        <th class="text-center">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.TenSp</td>
                            <td>@item.MoTa</td>
                            <td>@string.Format("{0:N0} ₫", item.DonGia)</td>
                            <td>@item.SoLuong</td>
                            <td>
                                @if (!string.IsNullOrEmpty(@item.HinhAnh))
                                {
                                    <img src="@item.HinhAnh" alt="Ảnh sản phẩm"
                                         class="img-thumbnail"
                                         style="width:100px; height:100px; object-fit:cover;" />
                                }
                                else
                                {
                                    <span class="text-muted">Chưa có ảnh</span>
                                }
                            </td>
                            <td>
                                @if (item.PhanTramGiam > 0)
                                {
                                    <span class="badge bg-warning text-dark">-@item.PhanTramGiam %</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Không</span>
                                }
                            </td>
                            <td>
                                @if (item.TrangThai)
                                {
                                    <span class="badge bg-success">Còn hàng</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Hết hàng</span>
                                }
                            </td>
                            <td>
                                <span class="badge bg-light text-dark">@item.MaLoaiNavigation?.TenLoai</span>
                            </td>
                            <td class="text-center">
                                <a asp-action="Edit" asp-route-id="@item.MaSp"
                                   class="btn btn-sm btn-outline-warning me-1" title="Chỉnh sửa">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <a asp-action="Details" asp-route-id="@item.MaSp"
                                   class="btn btn-sm btn-outline-info me-1" title="Chi tiết">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.MaSp"
                                   class="btn btn-sm btn-outline-danger" title="Xóa">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

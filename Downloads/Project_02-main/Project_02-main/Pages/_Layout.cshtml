@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Customer Site</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/shop.css" />
    <base href="~/" />
</head>
<body>
    <!-- SOCIAL NAVBAR -->
    <div class="social-navbar shadow-sm">
        <div class="container">
            <!-- MXH -->
            <div class="d-flex">
                <a href="https://facebook.com" target="_blank" class="nav-link"><i class="bi bi-facebook"></i></a>
                <a href="https://tiktok.com" target="_blank" class="nav-link"><i class="bi bi-tiktok"></i></a>
                <a href="https://youtube.com" target="_blank" class="nav-link"><i class="bi bi-youtube"></i></a>
            </div>

            <!-- Shop title căn giữa -->
            <a class="navbar-brand shop-center" asp-controller="Home" asp-action="Index">
                <h1 class="shop-title">NemeChua</h1>
            </a>

            <!-- Login -->
            <div>
                <a href="/Customer/Account/Login" class="login-link d-flex align-items-center">
                    <i class="bi bi-person-circle me-1"></i>Đăng nhập
                </a>
            </div>
        </div>
    </div>

    <!-- MAIN NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-light bg-light shadow-sm">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center me-3" asp-controller="Home" asp-action="Index">
                <img src="~/images/sanpham/ban3.png" alt="Logo" height="60" class="rounded">
            </a>
            <!-- Search ở giữa -->
            <form class="d-flex flex-grow-1 mx-4" role="search" onsubmit="event.preventDefault(); searchProduct();">
                <input id="searchInput" class="form-control rounded-pill w-100" type="search" placeholder="Tìm sản phẩm...">
            </form>

            <!-- Giỏ hàng bên phải -->
            <a href="javascript:void(0)" class="d-flex align-items-center" data-bs-toggle="offcanvas" data-bs-target="#cartOffcanvas">
                <i class="bi bi-cart3 me-1"></i> Giỏ hàng (<span id="cartCount">0</span>)
            </a>
        </div>
    </nav>
    <!-- Nền be/đất ấm -->
    <div class="categories bg2 text-center my-3">
        <button onclick="filterCategory('all')" class="btn btn-outline-success">Tất cả</button>
        <button onclick="filterCategory('Hải Sản')" class="btn btn-outline-success">Hải Sản</button>
        <button onclick="filterCategory('Gia Vị')" class="btn btn-outline-success">Gia Vị</button>
        <button onclick="filterCategory('Mỹ Phẩm')" class="btn btn-outline-success">Mỹ Phẩm</button>
        <button onclick="filterCategory('Quần Áo')" class="btn btn-outline-success">Quần Áo</button>
        <select class="form-select d-inline-block w-auto ms-2 border-success text-success" onchange="sortProducts(this.value)">
            <option value="">Sắp xếp</option>
            <option value="asc">Giá tăng dần</option>
            <option value="desc">Giá giảm dần</option>
        </select>
    </div>

    <!-- CONTENT -->
    <div class="container mt-4">
        @RenderBody()
    </div>
    <footer class="bg-dark text-white mt-auto py-4">
        <div class="container">
        <div class="row text-center text-md-start">
            <div class="col-md-4 mb-3">
                <h5>NemeChua</h5>
                <p>Chất lượng & Uy tín – Giao hàng nhanh chóng</p>
            </div>
            <div class="col-md-4 mb-3">
                <h5>Liên kết</h5>
                <ul class="list-unstyled">
                    <li><a asp-controller="Home" asp-action="Privacy" class="text-white">Chính sách bảo mật</a></li>
                    <li><a asp-controller="Home" asp-action="About" class="text-white">Giới thiệu</a></li>
                </ul>
            </div>
            <div class="col-md-4 mb-3">
                <h5>Kết nối</h5>
                <a href="https://facebook.com" class="text-white me-2">Facebook</a>
                <a href="https://instagram.com" class="text-white me-2">Instagram</a>
                <a href="https://tiktok.com" class="text-white">TikTok</a>
            </div>
            </div>
            <div class="text-center mt-3">
                &copy; 2025 NemeChua. All Rights Reserved.
            </div>
        </div>
    </footer>

    <!-- CART OFFCANVAS -->
    <div class="offcanvas offcanvas-end" tabindex="-1" id="cartOffcanvas" aria-labelledby="cartOffcanvasLabel">
        <div class="offcanvas-header bg-light border-bottom">
            <h5 class="offcanvas-title fw-bold" id="cartOffcanvasLabel"><i class="bi bi-cart3 me-2 text-primary"></i>Giỏ hàng của bạn</h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body d-flex flex-column">
            <div class="flex-grow-1 overflow-auto mb-3">
                <ul class="list-group list-group-flush" id="cartItems">
                    <li class="list-group-item text-center py-4 text-muted">Giỏ hàng trống</li>
                </ul>
            </div>
            
            <div class="border-top pt-3">
                <!-- Voucher Input -->
                <div class="input-group mb-2">
                    <input type="text" id="voucherCodeInput" class="form-control" placeholder="Mã giảm giá (nếu có)" />
                    <button class="btn btn-outline-primary" type="button" onclick="applyVoucher()">Áp dụng</button>
                </div>
                <div id="voucherMessage" class="small mb-2"></div>

                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted">Tạm tính:</span>
                    <span id="subTotal" class="fw-bold">0 ₫</span>
                </div>
                <div class="d-flex justify-content-between mb-1" id="discountRow" style="display: none !important;">
                    <span class="text-success">Giảm giá:</span>
                    <span id="discountAmount" class="fw-bold text-success">-0 ₫</span>
                </div>
                <div class="d-flex justify-content-between mb-3 border-top pt-2">
                    <span class="fw-bold fs-5">Tổng cộng:</span>
                    <span id="total" class="fw-bold fs-5 text-danger">0 ₫</span>
                </div>

                <button class="btn btn-danger w-100 py-2 fw-bold" onclick="openCheckoutModal()">
                    <i class="bi bi-credit-card me-1"></i> Tiến hành đặt hàng
                </button>
            </div>
        </div>
    </div>

    <!-- CHECKOUT MODAL -->
    <div class="modal fade" id="checkoutModal" tabindex="-1" aria-labelledby="checkoutModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold" id="checkoutModalLabel"><i class="bi bi-bag-check me-2"></i>Thông tin đặt hàng</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="checkoutForm" onsubmit="event.preventDefault(); submitOrder();">
                        <div class="mb-3">
                            <label for="orderCustomerName" class="form-label fw-bold">Họ và tên người nhận <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="orderCustomerName" required placeholder="Nguyễn Văn A">
                        </div>
                        <div class="mb-3">
                            <label for="orderPhone" class="form-label fw-bold">Số điện thoại giao hàng <span class="text-danger">*</span></label>
                            <input type="tel" class="form-control" id="orderPhone" required placeholder="09xxxxxxxx">
                        </div>
                        <div class="mb-3">
                            <label for="orderAddress" class="form-label fw-bold">Địa chỉ giao hàng <span class="text-danger">*</span></label>
                            <textarea class="form-control" id="orderAddress" rows="2" required placeholder="Số nhà, tên đường, phường/xã, quận/huyện..."></textarea>
                        </div>
                        <div class="mb-3">
                            <label for="orderNote" class="form-label">Ghi chú đơn hàng (nếu có)</label>
                            <input type="text" class="form-control" id="orderNote" placeholder="Ví dụ: Giao vào giờ hành chính">
                        </div>

                        <!-- Tóm tắt thanh toán -->
                        <div class="card bg-light border-0 p-3 mb-3">
                            <div class="d-flex justify-content-between mb-1">
                                <span>Tổng tiền hàng:</span>
                                <span id="modalSubTotal" class="fw-bold">0 ₫</span>
                            </div>
                            <div class="d-flex justify-content-between mb-1 text-success" id="modalDiscountRow" style="display:none !important;">
                                <span>Giảm giá voucher:</span>
                                <span id="modalDiscountAmount" class="fw-bold">-0 ₫</span>
                            </div>
                            <hr class="my-2">
                            <div class="d-flex justify-content-between fw-bold fs-5">
                                <span>Thành tiền:</span>
                                <span id="modalTotal" class="text-danger">0 ₫</span>
                            </div>
                        </div>

                        <div id="checkoutAlert" class="alert d-none" role="alert"></div>

                        <button type="submit" id="btnSubmitOrder" class="btn btn-success w-100 py-2 fw-bold">
                            <i class="bi bi-check2-circle me-1"></i> Xác nhận đặt hàng
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>

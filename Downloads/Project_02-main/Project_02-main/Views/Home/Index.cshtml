@model IEnumerable<Project_02.Models.SanPham>
@{
    ViewData["Title"] = "Danh sách sản phẩm";
    Layout = "~/Pages/_Layout.cshtml";
}

<div class="container mt-4">
    <h2 class="mb-4 text-center">Danh sách sản phẩm</h2>
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-3 mb-4">
                <div class="card h-100">
                    @if (!string.IsNullOrEmpty(item.HinhAnh))
                    {
                        <img src="@Url.Content("~/images/sanpham/" + item.HinhAnh)"
                             class="card-img-top" alt="@item.TenSp"
                             style="height: 200px; object-fit: cover;" />
                    }
                    else
                    {
                        <img src="@Url.Content("~/images/no-image.png")"
                             class="card-img-top" alt="Không có ảnh"
                             style="height: 200px; object-fit: cover;" />
                    }
                    <div class="card-body d-flex flex-column text-center">
                        <h5 class="card-title">@item.TenSp</h5>
                        <p class="card-text text-muted small">@item.MoTa</p>
                        <p class="text-danger fw-bold">@item.DonGia.ToString("N0") ₫</p>
                        <div class="d-flex flex-column gap-2 mt-auto">
                            <button class="btn btn-warning w-100 fw-bold" onclick="addToCart(@item.MaSp, '@item.TenSp.Replace("'", "\\'")' , @item.DonGia, '@(item.HinhAnh ?? "")')">
                                <i class="bi bi-cart-plus me-1"></i> Thêm vào giỏ
                            </button>
                            <div class="d-flex justify-content-center gap-2">
                                <a href="@Url.Action("Details", "Home", new { area = "Customer", id = item.MaSp })" class="btn btn-outline-primary btn-sm flex-grow-1">
                                    Xem chi tiết
                                </a>
                                <a href="~/Customer/Wishlist/MyWishlist" class="btn btn-outline-danger btn-sm" title="Yêu thích">
                                    <i class="bi bi-heart"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

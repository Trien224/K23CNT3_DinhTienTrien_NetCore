@model Project_02.Models.DanhGiaSanPham

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Sửa đánh giá sản phẩm";
}

<div class="container d-flex justify-content-center" style="min-height: 100vh;">
    <div class="card shadow-lg rounded-3" style="max-width: 600px; width: 100%;">
        <!-- Header -->
        <div class="card-header bg-warning text-white">
            <h4 class="mb-0">
                <i class="bi bi-pencil-square"></i> @ViewData["Title"]
            </h4>
        </div>

        <!-- Body -->
        <div class="card-body">
            <form asp-action="Edit" method="post" id="editForm">
                <input type="hidden" asp-for="MaDanhGia" />

                <!-- Khách hàng -->
                <div class="mb-3">
                    <label asp-for="MaKh" class="form-label fw-bold">
                        <i class="bi bi-person"></i> Khách hàng
                    </label>
                    <select asp-for="MaKh" class="form-select" asp-items="@(ViewData["MaKh"] as SelectList)" disabled></select>

                    <input type="hidden" asp-for="MaKh" /> <!-- giữ lại giá trị khi submit -->
                </div>

                <!-- Sản phẩm -->
                <div class="mb-3">
                    <label asp-for="MaSp" class="form-label fw-bold">
                        <i class="bi bi-box-seam"></i> Sản phẩm
                    </label>
                    <select asp-for="MaSp" class="form-select" asp-items="@(ViewData["MaSp"] as SelectList)" disabled></select>
                    <input type="hidden" asp-for="MaSp" /> <!-- giữ lại giá trị khi submit -->
                </div>

                <!-- Số sao -->
                <div class="mb-3">
                    <label asp-for="SoSao" class="form-label fw-bold">
                        <i class="bi bi-star"></i> Đánh giá sao
                    </label>
                    <div id="starRating" class="d-flex gap-2 fs-3 text-warning cursor-pointer">
                        <i class="bi bi-star" data-value="1"></i>
                        <i class="bi bi-star" data-value="2"></i>
                        <i class="bi bi-star" data-value="3"></i>
                        <i class="bi bi-star" data-value="4"></i>
                        <i class="bi bi-star" data-value="5"></i>
                    </div>
                    <input type="hidden" asp-for="SoSao" id="SoSao" />
                    <span asp-validation-for="SoSao" class="text-danger"></span>
                </div>

                <!-- Nội dung -->
                <div class="mb-3">
                    <label asp-for="NoiDung" class="form-label fw-bold">
                        <i class="bi bi-chat-dots"></i> Nội dung
                    </label>
                    <textarea asp-for="NoiDung" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="NoiDung" class="text-danger"></span>
                </div>

                <!-- Yêu thích -->
                <div class="form-check mb-3">
                    <input class="form-check-input" asp-for="LaYeuThich" />
                    <label class="form-check-label fw-bold" for="LaYeuThich">
                        <i class="bi bi-heart"></i> Đánh dấu yêu thích
                    </label>
                </div>

                <!-- Trạng thái -->
                <div class="mb-3">
                    <label asp-for="TrangThai" class="form-label fw-bold">
                        <i class="bi bi-eye"></i> Trạng thái
                    </label>
                    <select asp-for="TrangThai" class="form-select">
                        <option value="true">✔ Hiển thị</option>
                        <option value="false">🚫 Ẩn</option>
                    </select>
                </div>

                <!-- Buttons -->
                <div class="text-end">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Quay lại
                    </a>
                    <button type="submit" class="btn btn-warning">
                        <i class="bi bi-save"></i> Lưu
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>

                        $(document).ready(function () {
                    function highlightStars(count) {
                        $("#starRating i").removeClass("bi-star-fill").addClass("bi-star");
                        $("#starRating i").each(function () {
                            if ($(this).data("value") <= count) {
                                $(this).removeClass("bi-star").addClass("bi-star-fill");
                            }
                        });
                    }

                    var initialRating = parseInt($("#SoSao").val()) || 0;
                    highlightStars(initialRating);

                    $("#starRating i").on("mouseenter", function () {
                        highlightStars($(this).data("value"));
                    });

                    $("#starRating").on("mouseleave", function () {
                        highlightStars(parseInt($("#SoSao").val()) || 0);
                    });

                    $("#starRating i").on("click", function () {
                        var rating = $(this).data("value");
                        $("#SoSao").val(rating); // cập nhật input ẩn
                        highlightStars(rating);
                    });
                });
    </script>
}

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

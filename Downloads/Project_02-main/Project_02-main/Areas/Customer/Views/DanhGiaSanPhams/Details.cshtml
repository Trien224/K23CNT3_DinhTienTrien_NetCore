@model Project_02.Models.DanhGiaSanPham

@{
    ViewData["Title"] = "Chi tiết đánh giá";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg rounded-3">

                <!-- Header -->
                <div class="card-header bg-info text-white text-center">
                    <h4 class="mb-0">
                        <i class="bi bi-list-ul"></i> @ViewData["Title"]
                    </h4>
                </div>

                <!-- Body -->
                <div class="card-body p-4">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 fw-bold">
                            <i class="bi bi-hash me-1"></i> Mã đánh giá
                        </dt>
                        <dd class="col-sm-8">@Model.MaDanhGia</dd>

                        <dt class="col-sm-4 fw-bold">
                            <i class="bi bi-person me-1"></i> Khách hàng
                        </dt>
                        <dd class="col-sm-8">@Model.MaKhNavigation?.HoTen</dd>

                        <dt class="col-sm-4 fw-bold">
                            <i class="bi bi-bag me-1"></i> Sản phẩm
                        </dt>
                        <dd class="col-sm-8">@Model.MaSpNavigation?.TenSp</dd>

                        <dt class="col-sm-4 fw-bold">
                            <i class="bi bi-star-fill me-1"></i> Số sao
                        </dt>
                        <dd class="col-sm-8">@Model.SoSao / 5</dd>

                        <dt class="col-sm-4 fw-bold">
                            <i class="bi bi-chat-left-text me-1"></i> Nội dung
                        </dt>
                        <dd class="col-sm-8">@Model.NoiDung</dd>

                        <dt class="col-sm-4 fw-bold">
                            <i class="bi bi-heart-fill me-1"></i> Yêu thích
                        </dt>
                        <dd class="col-sm-8">
                            @(Model.LaYeuThich ? "Có" : "Không")
                        </dd>

                        <dt class="col-sm-4 fw-bold">
                            <i class="bi bi-calendar-event me-1"></i> Ngày tạo
                        </dt>
                        <dd class="col-sm-8">@Model.NgayTao.ToString("dd/MM/yyyy HH:mm")</dd>

                        <dt class="col-sm-4 fw-bold">
                            <i class="bi bi-eye me-1"></i> Trạng thái
                        </dt>
                        <dd class="col-sm-8">
                            <span class="badge @(Model.TrangThai ? "bg-success" : "bg-secondary")">
                                @(Model.TrangThai ? "Hiển thị" : "Ẩn")
                            </span>
                        </dd>
                    </dl>
                </div>

                <!-- Footer -->
                <div class="card-footer d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Quay lại
                    </a>
                    <a asp-action="Edit" asp-route-id="@Model.MaDanhGia" class="btn btn-warning text-white">
                        <i class="bi bi-pencil-square me-1"></i> Sửa
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

@model Project_02.Models.HoaDon

@{
   Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";   
    ViewData["Title"] = "Chi tiết hóa đơn";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg rounded-3">

                <!-- Header -->
                <div class="card-header bg-info text-white text-center">
                    <h4 class="mb-0"><i class="bi bi-receipt me-2"></i> @ViewData["Title"]</h4>
                </div>

                <!-- Body -->
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 fw-bold"><i class="bi bi-calendar-event me-1"></i> Ngày lập</dt>
                        <dd class="col-sm-8">@Model.NgayLap.ToString("dd/MM/yyyy HH:mm")</dd>

                        <dt class="col-sm-4 fw-bold"><i class="bi bi-currency-dollar me-1"></i> Tổng tiền</dt>
                        <dd class="col-sm-8">@String.Format("{0:N0} ₫", Model.TongTien)</dd>

                        <dt class="col-sm-4 fw-bold"><i class="bi bi-percent me-1"></i> Tiền giảm giá</dt>
                        <dd class="col-sm-8">@String.Format("{0:N0} ₫", Model.TienGiamGia)</dd>

                        <dt class="col-sm-4 fw-bold"><i class="bi bi-calculator me-1"></i> Thành tiền</dt>
                        <dd class="col-sm-8 text-danger fw-bold">@String.Format("{0:N0} ₫", Model.ThanhTien)</dd>

                        <dt class="col-sm-4 fw-bold"><i class="bi bi-geo-alt me-1"></i> Địa chỉ giao hàng</dt>
                        <dd class="col-sm-8">@Model.DiaChiGiaoHang</dd>

                        <dt class="col-sm-4 fw-bold"><i class="bi bi-telephone me-1"></i> SĐT giao hàng</dt>
                        <dd class="col-sm-8">@Model.SdtgiaoHang</dd>

                        <dt class="col-sm-4 fw-bold"><i class="bi bi-card-text me-1"></i> Ghi chú</dt>
                        <dd class="col-sm-8">@Model.GhiChu</dd>

                        <dt class="col-sm-4 fw-bold"><i class="bi bi-toggle-on me-1"></i> Trạng thái</dt>
                        <dd class="col-sm-8">
                            @switch (Model.TrangThai)
                            {
                                case 0:
                                    <span class="badge bg-warning text-dark"><i class="bi bi-clock me-1"></i> Chờ xử lý</span>
                                    break;
                                case 1:
                                    <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i> Đã thanh toán</span>
                                    break;
                                case 2:
                                    <span class="badge bg-info text-white"><i class="bi bi-truck me-1"></i> Đang giao hàng</span>
                                    break;
                                default:
                                    <span class="badge bg-success"><i class="bi bi-check2-circle me-1"></i> Đã giao thành công</span>
                                    break;
                            }
                        </dd>

                        <dt class="col-sm-4 fw-bold"><i class="bi bi-person me-1"></i> Khách hàng</dt>
                        <dd class="col-sm-8">@Model.MaKhNavigation?.HoTen</dd>

                        <dt class="col-sm-4 fw-bold"><i class="bi bi-ticket-perforated me-1"></i> Voucher</dt>
                        <dd class="col-sm-8">@Model.MaVoucherNavigation?.MaVoucher</dd>
                    </dl>
                </div>

                <!-- Footer -->
                <div class="card-footer d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Quay lại
                    </a>
                    <a asp-action="Edit" asp-route-id="@Model.MaHd" class="btn btn-warning text-white">
                        <i class="bi bi-pencil-square me-1"></i> Sửa
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">


@model IEnumerable<HoaDon>

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Danh sách Hóa đơn";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">
            <i class="bi bi-receipt"></i> @ViewData["Title"]
        </h2>
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Thêm mới
        </a>
    </div>

    <div class="card shadow border-0 rounded-3">
        <div class="card-body p-0">
            <table class="table table-hover table-striped mb-0 align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Ngày lập</th>
                        <th>Tổng tiền</th>
                        <th>Giảm giá</th>
                        <th>Tổng</th>
                        <th>Địa chỉ</th>
                        <th>Điện thoại</th>
                        <th>Ghi chú</th>
                        <th>Trạng thái</th>
                        <th>Họ tên</th>
                        <th>Voucher</th>
                        <th class="text-center">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.NgayLap.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@String.Format("{0:N0} ₫", item.TongTien)</td>
                            <td>@String.Format("{0:N0} ₫", item.TienGiamGia)</td>
                            <td>@String.Format("{0:N0} ₫", item.ThanhTien)</td>
                            <td>@item.DiaChiGiaoHang</td>
                            <td>@item.SdtgiaoHang</td>
                            <td>@item.GhiChu</td>
                            <td>
                                @switch (item.TrangThai)
                                {
                                    case 0:
                                        <span class="badge bg-warning text-dark">Chờ xử lý</span>
                                        ;
                                        break;
                                    case 1:
                                        <span class="badge bg-success">Đã thanh toán</span>
                                        ;
                                        break;
                                    case 2:
                                        <span class="badge bg-info text-dark">Đang giao hàng</span>
                                        ;
                                        break;
                                    default:
                                        <span class="badge bg-warning">Đã giao thành công</span>
                                        ;
                                        break;
                                }
                            </td>
                            <td>
                                <span class="badge bg-light text-dark">@item.MaKhNavigation?.HoTen</span>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark">@item.MaVoucherNavigation?.MaVoucher</span>
                            </td>
                            <td class="text-center">
                                <a asp-action="Edit" asp-route-id="@item.MaHd"
                                   class="btn btn-sm btn-outline-warning me-1" title="Chỉnh sửa">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <a asp-action="Details" asp-route-id="@item.MaHd"
                                   class="btn btn-sm btn-outline-info me-1" title="Chi tiết">
                                    <i class="bi bi-info-circle"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.MaHd"
                                   class="btn btn-sm btn-outline-danger" title="Xóa">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">


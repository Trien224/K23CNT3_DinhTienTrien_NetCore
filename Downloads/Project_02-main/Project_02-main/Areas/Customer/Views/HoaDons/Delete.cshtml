@model Project_02.Models.HoaDon

@{
    ViewData["Title"] = "Xóa Hóa đơn";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 rounded-3">
                <div class="card-header bg-danger text-white text-center">
                    <h4><i class="bi bi-exclamation-triangle"></i> Xác nhận xóa hóa đơn</h4>
                </div>
                <div class="card-body p-4">
                    <p class="text-center text-muted mb-4">
                        Bạn có chắc chắn muốn xóa hóa đơn này không? Hành động này không thể hoàn tác.
                    </p>

                    <dl class="row">
                        <dt class="col-sm-4 fw-bold">Ngày lập</dt>
                        <dd class="col-sm-8">@Model.NgayLap.ToString("dd/MM/yyyy HH:mm")</dd>

                        <dt class="col-sm-4 fw-bold">Tổng tiền</dt>
                        <dd class="col-sm-8 text-danger fw-bold">@String.Format("{0:N0} ₫", Model.TongTien)</dd>

                        <dt class="col-sm-4 fw-bold">Tiền giảm giá</dt>
                        <dd class="col-sm-8">@String.Format("{0:N0} ₫", Model.TienGiamGia)</dd>

                        <dt class="col-sm-4 fw-bold">Thành tiền</dt>
                        <dd class="col-sm-8 text-danger fw-bold">@String.Format("{0:N0} ₫", Model.ThanhTien)</dd>

                        <dt class="col-sm-4 fw-bold">Địa chỉ giao hàng</dt>
                        <dd class="col-sm-8">@Model.DiaChiGiaoHang</dd>

                        <dt class="col-sm-4 fw-bold">SĐT giao hàng</dt>
                        <dd class="col-sm-8">@Model.SdtgiaoHang</dd>

                        <dt class="col-sm-4 fw-bold">Ghi chú</dt>
                        <dd class="col-sm-8">@Model.GhiChu</dd>

                        <dt class="col-sm-4 fw-bold">Trạng thái</dt>
                        <dd class="col-sm-8">
                            @switch (Model.TrangThai)
                            {
                                case 0:
                                    <span class="badge bg-warning text-dark">Chưa thanh toán</span>
                                    break;
                                case 1:
                                    <span class="badge bg-success">Đã thanh toán</span>
                                    break;
                                case 2:
                                    <span class="badge bg-info">Đang giao hàng</span>
                                    break;
                                default:
                                    <span class="badge bg-warning">Đã nhận hàng</span>
                                    break;
                            }
                        </dd>

                        <dt class="col-sm-4 fw-bold">Khách hàng</dt>
                        <dd class="col-sm-8">@Model.MaKhNavigation?.HoTen</dd>

                        <dt class="col-sm-4 fw-bold">Voucher</dt>
                        <dd class="col-sm-8">@Model.MaVoucherNavigation?.MaVoucher ?? "Không có"</dd>
                    </dl>
                </div>
                <div class="card-footer d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> Quay lại
                    </a>
                    <form asp-action="Delete" method="post" class="d-inline">
                        <input type="hidden" asp-for="MaHd" />
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash"></i> Xóa
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
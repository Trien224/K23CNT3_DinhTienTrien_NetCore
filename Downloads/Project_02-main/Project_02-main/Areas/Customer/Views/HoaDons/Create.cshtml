@model Project_02.Models.HoaDonDto

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Thêm hóa đơn mới";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 rounded-3">
                <div class="card-header bg-success text-white">
                    <h4><i class="bi bi-receipt"></i> @ViewData["Title"]</h4>
                </div>
                <div class="card-body">
                    <form id="createForm">
                        <!-- Khách hàng -->
                        <div class="mb-3">
                            <label class="form-label fw-bold"><i class="bi bi-person"></i> Khách hàng</label>
                            <select id="MaKh" class="form-control" asp-items="ViewBag.MaKh"></select>
                        </div>

                        <!-- Voucher -->
                        <div class="mb-3">
                            <label class="form-label fw-bold"><i class="bi bi-ticket-perforated"></i> Voucher</label>
                            <select id="MaVoucher" class="form-control" asp-items="ViewBag.MaVoucher">
                                <option value="">-- Không dùng voucher --</option>
                            </select>
                        </div>

                        <!-- Địa chỉ & SĐT giao hàng -->
                        <div class="mb-3">
                            <label class="form-label fw-bold"><i class="bi bi-geo-alt"></i> Địa chỉ giao hàng</label>
                            <input id="DiaChiGiaoHang" class="form-control" placeholder="Nhập địa chỉ..." />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold"><i class="bi bi-telephone"></i> SĐT giao hàng</label>
                            <input id="SdtgiaoHang" class="form-control" placeholder="Nhập số điện thoại..." />
                        </div>

                        <!-- Ghi chú -->
                        <div class="mb-3">
                            <label class="form-label fw-bold"><i class="bi bi-journal-text"></i> Ghi chú</label>
                            <textarea id="GhiChu" class="form-control"></textarea>
                        </div>

                        <!-- Tổng tiền, giảm giá, thành tiền -->
                        <div class="mb-3 row">
                            <div class="col">
                                <label class="fw-bold"><i class="bi bi-cash-stack"></i> Tổng tiền</label>
                                <input id="TongTien" class="form-control" value="0" />
                            </div>
                            <div class="col">
                                <label class="fw-bold"><i class="bi bi-percent"></i> Giảm giá</label>
                                <input id="TienGiamGia" class="form-control" readonly />
                            </div>
                            <div class="col">
                                <label class="fw-bold"><i class="bi bi-currency-exchange"></i> Thành tiền</label>
                                <input id="ThanhTien" class="form-control" readonly />
                            </div>
                        </div>

                        <!-- Trạng thái -->
                        <div class="mb-4">
                            <label class="fw-bold"><i class="bi bi-hourglass-split"></i> Trạng thái</label>
                            <select id="TrangThai" class="form-control">
                                <option value="0">Chờ xử lý</option>
                                <option value="1">Đã thanh toán</option>
                                <option value="2">Đang giao hàng</option>
                                <option value="3">Đã giao thành công</option>
                            </select>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Quay lại</a>
                            <button type="submit" class="btn btn-success"><i class="bi bi-check-circle"></i> Lưu</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        $(function() {
            function tinhThanhTien() {
                let tongTien = parseFloat($("#TongTien").val()) || 0;
                let tienGiam = parseFloat($("#TienGiamGia").val()) || 0;
                $("#ThanhTien").val((tongTien - tienGiam).toFixed(0));
            }

            $("#MaVoucher, #TongTien").change(function(){
                let maVoucher = $("#MaVoucher").val();
                let tongTien = parseFloat($("#TongTien").val()) || 0;

                if(!maVoucher){
                    $("#TienGiamGia").val(0);
                    tinhThanhTien();
                    return;
                }

                $.getJSON('@Url.Action("TinhVoucher", "HoaDons")', { maVoucher, tongTien }, function(res){
                    if(res.success){
                        $("#TienGiamGia").val(res.tienGiam);
                        $("#ThanhTien").val(res.thanhTien);
                    } else {
                        Swal.fire("Lỗi", res.message, "error");
                        $("#TienGiamGia").val(0);
                        tinhThanhTien();
                    }
                });
            });

            $("#createForm").submit(function(e){
                e.preventDefault();
                let data = {
                    MaKh: parseInt($("#MaKh").val()),
                    MaVoucher: $("#MaVoucher").val() || null,
                    DiaChiGiaoHang: $("#DiaChiGiaoHang").val(),
                    SdtgiaoHang: $("#SdtgiaoHang").val(),
                    GhiChu: $("#GhiChu").val(),
                    TongTien: parseFloat($("#TongTien").val()),
                    TienGiamGia: parseFloat($("#TienGiamGia").val()),
                    ThanhTien: parseFloat($("#ThanhTien").val()),
                    TrangThai: parseInt($("#TrangThai").val())
                };

                $.ajax({
                    url: '@Url.Action("CreateAjax", "HoaDons")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(data),
                    success: function(res){
                        if(res.success){
                            Swal.fire("Thành công", res.message, "success").then(()=> location.href='@Url.Action("Index", "HoaDons")');
                        } else {
                            Swal.fire("Lỗi", res.message, "error");
                        }
                    },
                    error: function(){ Swal.fire("Lỗi", "Có lỗi xảy ra khi gửi dữ liệu.", "error"); }
                });
            });
        });
    </script>
}

@model Project_02.Models.ChiTietHoaDon

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Sửa chi tiết hóa đơn";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg border-0 rounded-3">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"><i class="bi bi-pencil-square"></i> @ViewData["Title"]</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="MaCthd" />
                        <input type="hidden" asp-for="MaHd" />
                        <input type="hidden" asp-for="MaSp" />

                        <!-- Hóa đơn -->
                        <div class="mb-3">
                            <label class="fw-bold">Hóa đơn</label>
                            <input type="text" class="form-control" value="@Model.MaHd" readonly />
                        </div>

                        <!-- Sản phẩm -->
                        <div class="mb-3">
                            <label class="fw-bold">Sản phẩm</label>
                            <input type="text" class="form-control" value="@Model.MaSpNavigation?.TenSp" readonly />
                        </div>

                        <!-- Số lượng -->
                        <div class="mb-3">
                            <label asp-for="SoLuong" class="fw-bold">Số lượng</label>
                            <input asp-for="SoLuong" class="form-control" id="SoLuong" />
                        </div>

                        <!-- Đơn giá -->
                        <div class="mb-3">
                            <label class="fw-bold">Đơn giá</label>
                            <input type="text" class="form-control" id="DonGiaDisplay" value="@Model.DonGia" readonly />
                        </div>

                        <!-- Thành tiền -->
                        <div class="mb-3">
                            <label class="fw-bold">Thành tiền</label>
                            <input type="text" class="form-control" id="ThanhTienDisplay" readonly />
                            <input type="hidden" asp-for="ThanhTien" id="ThanhTienHidden" />
                        </div>

                        <div class="text-end">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save"></i> Lưu
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary ms-2">
                                <i class="bi bi-arrow-left-circle"></i> Quay lại
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>
        function updateThanhTien() {
            var soLuong = parseFloat(document.getElementById("SoLuong").value) || 0;
            var donGia = parseFloat(document.getElementById("DonGiaDisplay").value) || 0;
            var thanhTien = soLuong * donGia;

            document.getElementById("ThanhTienDisplay").value = thanhTien.toLocaleString('vi-VN');
            document.getElementById("ThanhTienHidden").value = thanhTien;
        }

        document.getElementById("SoLuong").addEventListener("input", updateThanhTien);
        updateThanhTien();
    </script>
}

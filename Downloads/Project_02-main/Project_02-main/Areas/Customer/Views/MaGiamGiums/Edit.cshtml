@model Project_02.Models.MaGiamGium

@{
    ViewData["Title"] = "Chỉnh sửa mã giảm giá";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container d-flex justify-content-center align-items-center" style="min-height: 100vh;">
    <div class="card shadow-lg border-0 rounded-3" style="max-width: 700px; width: 100%;">
        <!-- Header -->
        <div class="card-header bg-warning text-white">
            <h4 class="mb-0"><i class="bi bi-ticket-perforated"></i> @ViewData["Title"]</h4>
        </div>

        <div class="card-body p-4">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="MaVoucher" />

                <!-- Tên voucher -->
                <div class="mb-3">
                    <label asp-for="TenVoucher" class="form-label fw-bold">
                        <i class="bi bi-tag"></i> Tên voucher
                    </label>
                    <input asp-for="TenVoucher" class="form-control" placeholder="Nhập tên voucher..." />
                    <span asp-validation-for="TenVoucher" class="text-danger"></span>
                </div>

                <!-- Mô tả -->
                <div class="mb-3">
                    <label asp-for="MoTa" class="form-label fw-bold">
                        <i class="bi bi-card-text"></i> Mô tả
                    </label>
                    <input asp-for="MoTa" class="form-control" placeholder="Nhập mô tả..." />
                    <span asp-validation-for="MoTa" class="text-danger"></span>
                </div>

                <!-- Phần trăm giảm -->
                <div class="mb-3">
                    <label asp-for="PhanTramGiam" class="form-label fw-bold">
                        <i class="bi bi-percent"></i> Phần trăm giảm
                    </label>
                    <input asp-for="PhanTramGiam" class="form-control" type="number" min="0" max="100" />
                    <span asp-validation-for="PhanTramGiam" class="text-danger"></span>
                </div>

                <!-- Giảm trực tiếp -->
                <div class="mb-3">
                    <label asp-for="GiamTienTrucTiep" class="form-label fw-bold">
                        <i class="bi bi-cash-stack"></i> Giảm tiền trực tiếp
                    </label>
                    <input asp-for="GiamTienTrucTiep" class="form-control" type="number" min="0" />
                    <span asp-validation-for="GiamTienTrucTiep" class="text-danger"></span>
                </div>

                <!-- Giá trị đơn tối thiểu -->
                <div class="mb-3">
                    <label asp-for="GiaTriDonToiThieu" class="form-label fw-bold">
                        <i class="bi bi-basket"></i> Giá trị đơn tối thiểu
                    </label>
                    <input asp-for="GiaTriDonToiThieu" class="form-control" type="number" min="0" />
                    <span asp-validation-for="GiaTriDonToiThieu" class="text-danger"></span>
                </div>

                <!-- Số lượng -->
                <div class="mb-3">
                    <label asp-for="SoLuong" class="form-label fw-bold">
                        <i class="bi bi-123"></i> Số lượng
                    </label>
                    <input asp-for="SoLuong" class="form-control" type="number" min="0" />
                    <span asp-validation-for="SoLuong" class="text-danger"></span>
                </div>

                <!-- Đã sử dụng -->
                <div class="mb-3">
                    <label asp-for="DaSuDung" class="form-label fw-bold">
                        <i class="bi bi-check2-circle"></i> Đã sử dụng
                    </label>
                    <input asp-for="DaSuDung" class="form-control" type="number" min="0" />
                    <span asp-validation-for="DaSuDung" class="text-danger"></span>
                </div>

                <!-- Ngày bắt đầu -->
                <div class="mb-3">
                    <label asp-for="NgayBatDau" class="form-label fw-bold">
                        <i class="bi bi-calendar-event"></i> Ngày bắt đầu
                    </label>
                    <input asp-for="NgayBatDau" class="form-control" type="date" />
                    <span asp-validation-for="NgayBatDau" class="text-danger"></span>
                </div>

                <!-- Ngày kết thúc -->
                <div class="mb-3">
                    <label asp-for="NgayKetThuc" class="form-label fw-bold">
                        <i class="bi bi-calendar-x"></i> Ngày kết thúc
                    </label>
                    <input asp-for="NgayKetThuc" class="form-control" type="date" />
                    <span asp-validation-for="NgayKetThuc" class="text-danger"></span>
                </div>

                <!-- Trạng thái -->
                <div class="form-check mb-3">
                    <input class="form-check-input" asp-for="TrangThai" />
                    <label class="form-check-label fw-bold" asp-for="TrangThai">
                        <i class="bi bi-toggle-on"></i> Trạng thái
                    </label>
                </div>

                <!-- Nút hành động -->
                <div class="text-end">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save"></i> Lưu thay đổi
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary ms-2">
                        <i class="bi bi-arrow-left"></i> Quay lại
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@model Project_02.Models.KhachHang
@{
    ViewData["Title"] = "Chi tiết khách hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}
<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg rounded-3">
                <div class="card-header bg-info text-white text-center">
                    <h4><i class="bi bi-person-badge"></i> @ViewData["Title"]</h4>
                </div>
                <div class="card-body p-4">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 fw-bold">Họ tên</dt><dd class="col-sm-8">@Model.HoTen</dd>
                        <dt class="col-sm-4 fw-bold">Email</dt><dd class="col-sm-8">@Model.Email</dd>
                        <dt class="col-sm-4 fw-bold">Điện thoại</dt><dd class="col-sm-8">@Model.DienThoai</dd>
                        <dt class="col-sm-4 fw-bold">Địa chỉ</dt><dd class="col-sm-8">@Model.DiaChi</dd>
                        <dt class="col-sm-4 fw-bold">Mật khẩu</dt><dd class="col-sm-8">****</dd>
                        <dt class="col-sm-4 fw-bold">Trạng thái</dt>
                        <dt class="col-sm-4 fw-bold">Trạng thái</dt>
                        <dd class="col-sm-8">
                            @if (Model.TrangThai)
                            {
                                <span class="badge bg-success">Hoạt động</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Ngưng</span>
                            }
                        </dd>

                    </dl>
                </div>
                <div class="card-footer d-flex justify-content-end gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.MaKh" class="btn btn-warning text-white"><i class="bi bi-pencil-square"></i> Chỉnh sửa</a>
                    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Quay lại</a>
                </div>
            </div>
        </div>
    </div>
</div>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

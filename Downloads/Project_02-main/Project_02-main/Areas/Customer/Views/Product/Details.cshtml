@model Project_02.Models.SanPham
@{
    ViewData["Title"] = "Chi tiết sản phẩm";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-5">
            <img src="~/images/@Model.HinhAnh" class="img-fluid" alt="@Model.TenSp" />
        </div>
        <div class="col-md-7">
            <h2>@Model.TenSp</h2>
            <h4 class="text-danger">@Model.DonGia.ToString("n0") VNĐ</h4>
            <p>@Model.MoTa</p>
            <p>Số lượng tồn: @Model.SoLuong</p>
        </div>
    </div>
</div>

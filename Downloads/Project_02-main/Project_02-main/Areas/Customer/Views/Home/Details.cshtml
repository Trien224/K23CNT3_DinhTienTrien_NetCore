@model Project_02.Models.SanPham

<div class="container mt-4">
    <h2>@Model.TenSp</h2>
    <div class="card-body p-4">
        <div class="row">
            <div class="col-md-4 text-center">
                @if (!string.IsNullOrEmpty(Model.HinhAnh))
                {
                    <img src="~/images/sanpham/@Model.HinhAnh"
                         class="img-fluid rounded shadow-sm mb-3 border"
                         alt="@Model.TenSp" />
                }
                else
                {
                    <img src="~/images/no-image.png"
                         class="img-fluid rounded shadow-sm mb-3 border"
                         alt="No Image" />
                }
            </div>


            <div class="col-md-8">
                <dl class="row mb-0">
                    <dt class="col-sm-4 fw-bold"><i class="bi bi-box-seam me-1"></i> Tên sản phẩm</dt>
                    <dd class="col-sm-8">@Model.TenSp</dd>

                    <dt class="col-sm-4 fw-bold"><i class="bi bi-card-text me-1"></i> Mô tả</dt>
                    <dd class="col-sm-8">@Model.MoTa</dd>

                    <dt class="col-sm-4 fw-bold"><i class="bi bi-currency-dollar me-1"></i> Đơn giá</dt>
                    <dd class="col-sm-8 text-danger fw-bold">@String.Format("{0:N0} ₫", Model.DonGia)</dd>



                    <dt class="col-sm-4 fw-bold"><i class="bi bi-tag me-1"></i> Giảm giá</dt>
                    <dd class="col-sm-8">
                        @if (Model.PhanTramGiam > 0)
                        {
                            <span class="badge bg-success">-@Model.PhanTramGiam %</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Không</span>
                        }
                    </dd>

                    <dt class="col-sm-4 fw-bold"><i class="bi bi-toggle-on me-1"></i> Trạng thái</dt>
                    <dd class="col-sm-8">
                        @if (Model.TrangThai)
                        {
                            <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i> Đang bán</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary"><i class="bi bi-x-circle me-1"></i> Ngưng bán</span>
                        }
                    </dd>

                    <dt class="col-sm-4 fw-bold mt-3"><i class="bi bi-cart me-1"></i> Số lượng</dt>
                    <dd class="col-sm-8 mt-3">
                        <div class="input-group" style="width: 140px;">
                            <button class="btn btn-outline-secondary" type="button" onclick="changeDetailQty(-1)">-</button>
                            <input type="number" id="detailQty" class="form-control text-center" value="1" min="1" max="99">
                            <button class="btn btn-outline-secondary" type="button" onclick="changeDetailQty(1)">+</button>
                        </div>
                    </dd>
                </dl>

                <div class="mt-4 d-flex gap-3">
                    <button class="btn btn-warning btn-lg fw-bold" onclick="addDetailToCart(@Model.MaSp, '@Model.TenSp.Replace("'", "\\'")' , @Model.DonGia, '@(Model.HinhAnh ?? "")')">
                        <i class="bi bi-cart-plus me-1"></i> Thêm vào giỏ hàng
                    </button>
                    <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary btn-lg">
                        <i class="bi bi-arrow-left me-1"></i> Quay lại
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function changeDetailQty(delta) {
        const input = document.getElementById('detailQty');
        let val = parseInt(input.value) || 1;
        val = Math.max(1, val + delta);
        input.value = val;
    }

    function addDetailToCart(id, name, price, img) {
        const qty = parseInt(document.getElementById('detailQty')?.value) || 1;
        addToCart(id, name, price, img, qty);
    }
</script>

@model Project_02.Models.SanPham

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Xóa sản phẩm";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger text-center">
                    <i class="bi bi-exclamation-octagon"></i> @TempData["Error"]
                </div>
            }

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success text-center">
                    <i class="bi bi-check-circle"></i> @TempData["Success"]
                </div>
            }

            <div class="card shadow-lg border-0 rounded-3">
                <div class="card-header bg-danger text-white text-center">
                    <h4><i class="bi bi-exclamation-triangle"></i> Xác nhận xóa sản phẩm</h4>
                </div>

                <div class="card-body p-4">
                    <p class="text-center text-muted mb-4">
                        Bạn có chắc chắn muốn xóa sản phẩm này không? Hành động này <strong>không thể hoàn tác</strong>.
                    </p>

                    <div class="row align-items-center">
                        <div class="col-md-4 text-center">
                            @if (!string.IsNullOrEmpty(Model.HinhAnh))
                            {
                                <img src="~/images/sanpham/@Model.HinhAnh"
                                     alt="@Model.TenSp"
                                     class="img-fluid rounded shadow-sm border mb-3"
                                     style="max-height: 200px;" />
                            }
                            else
                            {
                                <img src="~/images/no-image.png"
                                     alt="No Image"
                                     class="img-fluid rounded shadow-sm border mb-3"
                                     style="max-height: 200px;" />
                            }
                        </div>

                        <div class="col-md-8">
                            <dl class="row mb-0">
                                <dt class="col-sm-4 fw-bold">Tên sản phẩm</dt>
                                <dd class="col-sm-8">@Model.TenSp</dd>

                                <dt class="col-sm-4 fw-bold">Mô tả</dt>
                                <dd class="col-sm-8">@Model.MoTa</dd>

                                <dt class="col-sm-4 fw-bold">Đơn giá</dt>
                                <dd class="col-sm-8 text-danger fw-bold">
                                    @String.Format("{0:N0} ₫", Model.DonGia)
                                </dd>

                                <dt class="col-sm-4 fw-bold">Số lượng</dt>
                                <dd class="col-sm-8">@Model.SoLuong</dd>

                                <dt class="col-sm-4 fw-bold">Giảm giá</dt>
                                <dd class="col-sm-8">
                                    @if (Model.PhanTramGiam > 0)
                                    {
                                        <span class="badge bg-success">-@Model.PhanTramGiam %</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Không</span>
                                    }
                                </dd>

                                <dt class="col-sm-4 fw-bold">Trạng thái</dt>
                                <dd class="col-sm-8">
                                    @if (Model.TrangThai)
                                    {
                                        <span class="badge bg-warning text-dark">Đang bán</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Ngưng bán</span>
                                    }
                                </dd>

                                <dt class="col-sm-4 fw-bold">Loại sản phẩm</dt>
                                <dd class="col-sm-8">@Model.MaLoaiNavigation?.TenLoai</dd>
                            </dl>
                        </div>
                    </div>
                </div>

                <div class="card-footer d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> Quay lại
                    </a>
                    <form asp-action="Delete" method="post" class="d-inline">
                        <input type="hidden" asp-for="MaSp" />
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash"></i> Xóa
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@model Project_02.Models.QuanTriVien

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Chỉnh sửa quản trị viên";
}

<div class="container d-flex justify-content-center " style="min-height: 100vh;">
    <div class="card shadow-lg border-0 rounded-3" style="max-width: 700px; width: 100%;">
        <!-- Header -->
        <div class="card-header bg-warning text-white">
            <h4 class="mb-0"><i class="bi bi-person-gear"></i> @ViewData["Title"]</h4>
        </div>

        <div class="card-body p-4">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="MaQtv" />

                <!-- Họ tên -->
                <div class="mb-3">
                    <label asp-for="HoTen" class="form-label fw-bold">
                        <i class="bi bi-person"></i> Họ tên
                    </label>
                    <input asp-for="HoTen" class="form-control" placeholder="Nhập họ tên..." />
                    <span asp-validation-for="HoTen" class="text-danger"></span>
                </div>

                <!-- Email -->
                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-bold">
                        <i class="bi bi-envelope"></i> Email
                    </label>
                    <input asp-for="Email" class="form-control" placeholder="Nhập email..." type="email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <!-- Mật khẩu -->
                <div class="mb-3">
                    <label asp-for="MatKhau" class="form-label fw-bold">
                        <i class="bi bi-lock"></i> Mật khẩu
                    </label>
                    <input asp-for="MatKhau" class="form-control" placeholder="Nhập mật khẩu..." type="password" />
                    <span asp-validation-for="MatKhau" class="text-danger"></span>
                </div>

                <!-- Điện thoại -->
                <div class="mb-3">
                    <label asp-for="DienThoai" class="form-label fw-bold">
                        <i class="bi bi-telephone"></i> Điện thoại
                    </label>
                    <input asp-for="DienThoai" class="form-control" placeholder="Nhập số điện thoại..." />
                    <span asp-validation-for="DienThoai" class="text-danger"></span>
                </div>

                <!-- Địa chỉ -->
                <div class="mb-3">
                    <label asp-for="DiaChi" class="form-label fw-bold">
                        <i class="bi bi-geo-alt"></i> Địa chỉ
                    </label>
                    <input asp-for="DiaChi" class="form-control" placeholder="Nhập địa chỉ..." />
                    <span asp-validation-for="DiaChi" class="text-danger"></span>
                </div>

                <!-- Trạng thái -->
                <div class="form-check mb-3">
                    <input class="form-check-input" asp-for="TrangThai" />
                    <label class="form-check-label fw-bold" asp-for="TrangThai">
                        <i class="bi bi-toggle-on"></i> Trạng thái
                    </label>
                </div>

                <!-- Nút hành động -->
                <div class="text-end">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save"></i> Lưu thay đổi
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary ms-2">
                        <i class="bi bi-arrow-left"></i> Quay lại
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

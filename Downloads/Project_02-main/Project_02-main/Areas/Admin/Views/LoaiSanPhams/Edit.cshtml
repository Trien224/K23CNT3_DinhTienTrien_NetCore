@model LoaiSanPham

@{
    ViewData["Title"] = "Chỉnh sửa loại sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container d-flex justify-content-center ">
    <div class="card shadow-lg border-0 rounded-3" style="max-width: 700px; width: 100%;">
        <!-- Header -->
        <div class="card-header bg-warning text-white">
            <h4 class="mb-0"><i class="bi bi-pencil-square"></i> @ViewData["Title"]</h4>
        </div>

        <div class="card-body p-4">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="MaLoai" />

                <!-- Tên loại -->
                <div class="mb-3">
                    <label asp-for="TenLoai" class="form-label fw-bold">
                        <i class="bi bi-tag"></i> Tên loại
                    </label>
                    <input asp-for="TenLoai" class="form-control" placeholder="Nhập tên loại sản phẩm..." />
                    <span asp-validation-for="TenLoai" class="text-danger"></span>
                </div>

                <!-- Mô tả -->
                <div class="mb-3">
                    <label asp-for="MoTa" class="form-label fw-bold">
                        <i class="bi bi-card-text"></i> Mô tả
                    </label>
                    <textarea asp-for="MoTa" class="form-control" rows="3" placeholder="Nhập mô tả loại sản phẩm..."></textarea>
                    <span asp-validation-for="MoTa" class="text-danger"></span>
                </div>

                <!-- Trạng thái -->
                <div class="form-check mb-3">
                    <input class="form-check-input" asp-for="TrangThai" />
                    <label class="form-check-label fw-bold" asp-for="TrangThai">
                        <i class="bi bi-toggle-on"></i> Trạng thái
                    </label>
                </div>

                <!-- Nút hành động -->
                <div class="text-end">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save"></i> Lưu thay đổi
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary ms-2">
                        <i class="bi bi-arrow-left"></i> Quay lại
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

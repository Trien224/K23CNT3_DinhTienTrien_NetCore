@model NemeShop.Models.HoaDon

@{
    ViewData["Title"] = "Chi tiết hóa đơn";
}

<div class="container mt-4 order-detail-page">
    <!-- Header với gradient và shadow -->
    <div class="order-header bg-gradient-primary rounded-3 p-4 mb-4 shadow-lg">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h2 class="text-white mb-1">Chi tiết hóa đơn</h2>
                <p class="text-white-50 mb-0">#@Model.MaHd</p>
            </div>
            <a href="@Url.Action("MyOrders", "HoaDon")" class="btn btn-light btn-hover-scale">
                <i class="bi bi-arrow-left me-2"></i>Quay lại đơn hàng
            </a>
        </div>
    </div>

    <div class="row g-4 pb-5">
        <div class="col-lg-8">
            <!-- Thông tin khách hàng -->
            <div class="card modern-card border-0 h-100">
                <div class="card-header bg-transparent border-0 pb-0">
                    <h5 class="card-title gradient-text">
                        <i class="bi bi-person-circle me-2"></i>Thông tin khách hàng
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label text-muted small">Họ tên</label>
                            <p class="fw-semibold mb-0">@Model.MaKhNavigation?.HoTen</p>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted small">Ngày lập</label>
                            <p class="fw-semibold mb-0">@Model.NgayLap.ToString("dd/MM/yyyy HH:mm")</p>
                        </div>
                        <div class="col-12">
                            <label class="form-label text-muted small">Địa chỉ giao hàng</label>
                            <p class="fw-semibold mb-0">@Model.DiaChiGiaoHang</p>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted small">Điện thoại</label>
                            <p class="fw-semibold mb-0">@Model.SdtgiaoHang</p>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted small">Ghi chú</label>
                            <p class="fw-semibold mb-0 text-primary">@(string.IsNullOrEmpty(Model.GhiChu) ? "Không có ghi chú" : Model.GhiChu)</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Danh sách sản phẩm -->
            <div class="card modern-card border-0 mt-4">
                <div class="card-header bg-transparent border-0 pb-0">
                    <h5 class="card-title gradient-text">
                        <i class="bi bi-cart-check me-2"></i>Danh sách sản phẩm
                    </h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Sản phẩm</th>
                                    <th class="text-center">Số lượng</th>
                                    <th class="text-end pe-4">Đơn giá</th>
                                    <th class="text-end pe-4">Thành tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.ChiTietHoaDons)
                                {
                                    var giaGoc = ViewData[$"GiaGoc_{item.MaSp}"] as decimal?;
                                    var phanTramGiam = ViewData[$"PhanTramGiam_{item.MaSp}"] as decimal?;
                                    var coGiamGia = giaGoc.HasValue && phanTramGiam.HasValue && phanTramGiam > 0;

                                    <tr class="product-row">
                                        <td class="ps-4">
                                            <div class="d-flex align-items-center">
                                                <div class="product-image-wrapper me-3">
                                                    <img src="@(item.MaSpNavigation?.HinhAnh ?? "/images/placeholder.png")"
                                                         class="rounded-2 product-image"
                                                         alt="@item.MaSpNavigation?.TenSp"
                                                         onerror="this.src='/images/placeholder.png'">
                                                    @if (coGiamGia)
                                                    {
                                                        <span class="discount-badge">-@phanTramGiam%</span>
                                                    }
                                                </div>
                                                <div>
                                                    <div class="fw-semibold">@item.MaSpNavigation?.TenSp</div>
                                                    @if (coGiamGia)
                                                    {
                                                        <div class="text-success small fw-medium">
                                                            <i class="bi bi-tag me-1"></i>Đã giảm giá
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-center">
                                            <span class="quantity-badge">@item.SoLuong</span>
                                        </td>
                                        <td class="text-end pe-4">
                                            @if (coGiamGia)
                                            {
                                                <div>
                                                    <div class="text-muted text-decoration-line-through small">
                                                        @String.Format("{0:N0} ₫", giaGoc)
                                                    </div>
                                                    <div class="text-danger fw-bold fs-6">
                                                        @String.Format("{0:N0} ₫", item.DonGia)
                                                    </div>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="text-danger fw-bold fs-6">
                                                    @String.Format("{0:N0} ₫", item.DonGia)
                                                </div>
                                            }
                                        </td>
                                        <td class="text-end pe-4">
                                            <span class="fw-bold text-danger fs-6">
                                                @String.Format("{0:N0} ₫", item.ThanhTien)
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <!-- Tổng kết đơn hàng -->
            <div class="card modern-card border-0">
                <div class="card-header bg-transparent border-0 pb-0">
                    <h5 class="card-title gradient-text">
                        <i class="bi bi-receipt me-2"></i>Tổng kết đơn hàng
                    </h5>
                </div>
                <div class="card-body">
                    <div class="summary-item d-flex justify-content-between align-items-center mb-3">
                        <span class="text-muted">Tổng tiền hàng:</span>
                        <span class="fw-semibold">@String.Format("{0:N0} ₫", Model.TongTien)</span>
                    </div>

                    @{
                        var tongGiamGia = Model.TongTien - Model.ThanhTien;
                    }
                    @if (tongGiamGia > 0)
                    {
                        <div class="summary-item d-flex justify-content-between align-items-center mb-3 text-success">
                            <span>Giảm giá:</span>
                            <span class="fw-bold">-@String.Format("{0:N0} ₫", tongGiamGia)</span>
                        </div>
                    }

                    <hr class="my-4">
                    <div class="summary-total d-flex justify-content-between align-items-center mb-4">
                        <span class="fw-bold fs-5">Tổng thanh toán:</span>
                        <span class="fw-bold text-danger fs-4">@String.Format("{0:N0} ₫", Model.ThanhTien)</span>
                    </div>

                    <!-- Trạng thái đơn hàng -->
                    <div class="status-card">
                        <div class="alert @(Model.TrangThai == 1 ? "alert-success" : "alert-warning") border-0 rounded-3">
                            <div class="d-flex align-items-center">
                                <i class="bi @(Model.TrangThai == 1 ? "bi-check-circle-fill" : "bi-clock") me-2 fs-5"></i>
                                <div>
                                    <strong>Trạng thái:</strong>
                                    @if (Model.TrangThai == 1)
                                    {
                                        <span class="badge bg-success ms-2">Đã xác nhận</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning ms-2">Chờ xác nhận</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Actions -->
                    <div class="d-grid gap-2 mt-4">
                        <button class="btn btn-primary btn-hover-scale">
                            <i class="bi bi-printer me-2"></i>In hóa đơn
                        </button>
                        <button class="btn btn-outline-primary btn-hover-scale">
                            <i class="bi bi-download me-2"></i>Tải PDF
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        /* QUAN TRỌNG: Fix triệt để footer overlapping */
        .order-detail-page {
            min-height: 80vh;
            position: relative;
            z-index: 1;
        }

        /* Đảm bảo main content có đủ khoảng cách với footer */
        main.container-fluid {
            padding-bottom: 8rem !important;
            margin-bottom: 4rem;
        }

        /* Tạo khoảng cách an toàn phía dưới nội dung */
        .pb-5 {
            padding-bottom: 6rem !important;
        }

        /* Đảm bảo body có đủ chiều cao */
        body {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* Main content chiếm hết không gian còn lại */
        main {
            flex: 1 0 auto;
        }

        /* Footer ở dưới cùng */
        footer {
            flex-shrink: 0;
            margin-top: auto;
        }

        /* Responsive fixes - QUAN TRỌNG */
        @@media (max-width: 768px) {
            .order-detail-page {
                min-height: 85vh;
            }

            main.container-fluid {
                padding-bottom: 10rem !important;
            }

            .pb-5 {
                padding-bottom: 8rem !important;
            }
            /* Remove sticky trên mobile để tránh conflict */
            .sticky-top {
                position: relative !important;
            }
        }

        /* Small mobile devices */
        @@media (max-width: 576px) {
            main.container-fluid {
                padding-bottom: 12rem !important;
            }

            .pb-5 {
                padding-bottom: 10rem !important;
            }
        }

        /* Các styles hiện có giữ nguyên */
        .order-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }

        .modern-card {
            background: #fff;
            border-radius: 16px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.08);
            transition: all 0.3s ease;
            border: 1px solid rgba(255,255,255,0.2);
            margin-bottom: 1.5rem;
        }

            .modern-card:hover {
                box-shadow: 0 8px 30px rgba(0,0,0,0.12);
                transform: translateY(-2px);
            }

        .gradient-text {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .product-image-wrapper {
            position: relative;
        }

        .product-image {
            width: 60px;
            height: 60px;
            object-fit: cover;
            transition: transform 0.3s ease;
        }

        .product-row:hover .product-image {
            transform: scale(1.1);
        }

        .discount-badge {
            position: absolute;
            top: -5px;
            right: -5px;
            background: #dc3545;
            color: white;
            border-radius: 12px;
            padding: 2px 8px;
            font-size: 0.7rem;
            font-weight: 600;
        }

        .quantity-badge {
            background: #e9ecef;
            color: #495057;
            padding: 4px 12px;
            border-radius: 20px;
            font-weight: 600;
            font-size: 0.9rem;
        }

        .btn-hover-scale {
            transition: all 0.3s ease;
        }

            .btn-hover-scale:hover {
                transform: scale(1.02);
            }

        .summary-item, .summary-total {
            padding: 8px 0;
            border-bottom: 1px solid #f8f9fa;
        }

        .status-card .alert {
            border-left: 4px solid;
        }

        .table th {
            border-top: none;
            font-weight: 600;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #6c757d;
        }

        .table tbody tr {
            transition: background-color 0.2s ease;
        }

            .table tbody tr:hover {
                background-color: #f8f9fa;
            }

        .table-responsive {
            margin-bottom: 1rem;
        }

        /* Dark mode support */
        [data-bs-theme="dark"] .modern-card {
            background: #1e293b;
            border-color: #334155;
        }

        [data-bs-theme="dark"] .table-light {
            background-color: #334155 !important;
            color: #f8f9fa;
        }

        [data-bs-theme="dark"] .table tbody tr:hover {
            background-color: #2d3748;
        }

        [data-bs-theme="dark"] .quantity-badge {
            background: #4a5568;
            color: #e2e8f0;
        }
    </style>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Print button functionality
            document.querySelector('.btn-primary')?.addEventListener('click', function() {
                window.print();
            });

            // Download PDF button functionality
            document.querySelector('.btn-outline-primary')?.addEventListener('click', function() {
                alert('Tính năng tải PDF sẽ được triển khai sau!');
            });

            // Force footer to bottom on load
            function ensureFooterPosition() {
                const body = document.body;
                const html = document.documentElement;
                const footer = document.querySelector('footer');

                if (body.scrollHeight <= window.innerHeight && footer) {
                    footer.style.position = 'absolute';
                    footer.style.bottom = '0';
                    footer.style.width = '100%';
                }
            }

            // Check on load and resize
            ensureFooterPosition();
            window.addEventListener('resize', ensureFooterPosition);
        });
    </script>
}
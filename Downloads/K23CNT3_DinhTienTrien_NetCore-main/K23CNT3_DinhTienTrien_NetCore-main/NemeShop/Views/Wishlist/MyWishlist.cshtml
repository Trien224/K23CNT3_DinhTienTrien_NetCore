@model List<NemeShop.Models.ProductWishlistDto>
@{
    ViewData["Title"] = "Sản phẩm yêu thích";
    var isLoggedIn = Context.Session.GetInt32("MaKh") != null;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-heart-fill text-danger me-2"></i>Sản phẩm yêu thích</h2>
        <div>
            <button type="button" id="selectAllBtn" class="btn btn-outline-secondary btn-sm me-2">
                <i class="bi bi-check-square me-1"></i>Chọn tất cả
            </button>
            <button type="button" id="unselectAllBtn" class="btn btn-outline-secondary btn-sm me-2">
                <i class="bi bi-square me-1"></i>Bỏ chọn
            </button>
            <a href="/" class="btn btn-outline-primary btn-sm">
                <i class="bi bi-arrow-left me-2"></i>Tiếp tục mua sắm
            </a>
        </div>
    </div>

    @if (!isLoggedIn)
    {
        <div class="alert alert-warning text-center py-4">
            <i class="bi bi-exclamation-triangle me-2"></i>
            Vui lòng <a href="/Account/Login" class="alert-link">đăng nhập</a> để xem sản phẩm yêu thích.
        </div>
    }
    else if (Model == null || !Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-heart text-muted" style="font-size: 4rem;"></i>
            <h4 class="mt-3 text-muted">Chưa có sản phẩm yêu thích</h4>
            <p class="text-muted">Hãy thêm sản phẩm bạn yêu thích vào danh sách này!</p>
            <a href="/" class="btn btn-primary mt-3">
                <i class="bi bi-bag me-2"></i>Khám phá sản phẩm
            </a>
        </div>
    }
    else
    {
        <form id="wishlistForm">
            @Html.AntiForgeryToken()
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <div class="form-check mb-0">
                        <input class="form-check-input" type="checkbox" id="checkAll">
                        <label class="form-check-label fw-bold" for="checkAll">
                            Chọn tất cả (@Model.Count sản phẩm)
                        </label>
                    </div>
                    <div>
                        <button type="button" id="removeSelectedBtn" class="btn btn-outline-danger btn-sm me-2">
                            <i class="bi bi-trash me-1"></i>Xóa đã chọn
                        </button>
                        <button type="button" id="checkoutSelectedBtn" class="btn btn-primary btn-sm">
                            <i class="bi bi-cart-check me-1"></i>Thanh toán đã chọn
                        </button>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 50px;" class="text-center">Chọn</th>
                                    <th style="width: 80px;">Hình ảnh</th>
                                    <th>Sản phẩm</th>
                                    <th class="text-center">Giá</th>
                                    <th class="text-center" style="width: 120px;">Số lượng</th>
                                    <th class="text-center">Tồn kho</th>
                                    <th class="text-center" style="width: 120px;">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr class="product-row @(item.Stock <= 0 ? "table-warning" : "")" data-product-id="@item.ProductId">
                                        <td class="text-center">
                                            <input type="checkbox" class="form-check-input product-checkbox"
                                                   value="@item.ProductId"
                                                   @(item.Stock <= 0 ? "disabled" : "")
                                                   data-price="@item.Price"
                                                   data-name="@item.ProductName"
                                                   data-image="@item.Image"
                                                   data-stock="@item.Stock">
                                        </td>
                                        <td>
                                            <img src="@(string.IsNullOrEmpty(item.Image) ? "/images/placeholder.png" : item.Image)"
                                                 class="rounded" style="width: 60px; height: 60px; object-fit: cover;"
                                                 alt="@item.ProductName">
                                        </td>
                                        <td>
                                            <div>
                                                <h6 class="mb-1">@item.ProductName</h6>
                                                <p class="text-muted small mb-1">@item.Category</p>
                                                <small class="text-muted">
                                                    <i class="bi bi-calendar me-1"></i>Đã thêm: @item.AddedDate.ToString("dd/MM/yyyy")
                                                </small>
                                            </div>
                                        </td>
                                        <td class="text-center">
                                            <h6 class="text-danger mb-0">@String.Format("{0:N0} ₫", item.Price)</h6>
                                        </td>
                                        <td class="text-center">
                                            <div class="quantity-controls d-flex align-items-center justify-content-center">
                                                @if (item.Stock > 0)
                                                {
                                                    <button type="button" class="btn btn-outline-secondary btn-sm quantity-decrease"
                                                            @(item.Quantity <= 1 ? "disabled" : "")>
                                                        <i class="bi bi-dash"></i>
                                                    </button>
                                                    <input type="number" class="form-control quantity-input mx-2 text-center"
                                                           value="@item.Quantity" min="1" max="@item.Stock"
                                                           style="width: 70px;" data-product-id="@item.ProductId">
                                                    <button type="button" class="btn btn-outline-secondary btn-sm quantity-increase"
                                                            @(item.Quantity >= item.Stock ? "disabled" : "")>
                                                        <i class="bi bi-plus"></i>
                                                    </button>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </div>
                                        </td>
                                        <td class="text-center">
                                            @if (item.Stock > 0)
                                            {
                                                <span class="badge bg-success">@item.Stock sản phẩm</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">Hết hàng</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            <div class="btn-group btn-group-sm" role="group">
                                                <a href="@Url.Action("Details", "Home", new { id = item.ProductId })"
                                                   class="btn btn-outline-primary" title="Xem chi tiết">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                                <button type="button" class="btn btn-outline-danger remove-wishlist"
                                                        data-reviewid="@item.MaDanhGia" title="Xóa khỏi yêu thích">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </form>

        <!-- Tổng kết đơn hàng -->
        <div class="card shadow-sm">
            <div class="card-header bg-light">
                <h5 class="mb-0"><i class="bi bi-receipt me-2"></i>Tổng kết đơn hàng</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <div class="d-flex justify-content-between mb-2">
                            <span>Số sản phẩm đã chọn:</span>
                            <strong id="selectedCount">0</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Tổng tiền hàng:</span>
                            <strong id="subtotal">0 ₫</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Phí vận chuyển:</span>
                            <strong id="shippingFee">0 ₫</strong>
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between fw-bold fs-5">
                            <span>Tổng thanh toán:</span>
                            <strong class="text-danger" id="totalAmount">0 ₫</strong>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="d-grid gap-2">
                            <button type="button" id="finalCheckoutBtn" class="btn btn-primary btn-lg" disabled>
                                <i class="bi bi-credit-card me-2"></i>Tiến hành thanh toán
                            </button>
                            <small class="text-muted text-center">
                                <i class="bi bi-info-circle me-1"></i>
                                Vui lòng chọn ít nhất 1 sản phẩm để thanh toán
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Modal xác nhận thanh toán -->
<div class="modal fade" id="checkoutModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">
                    <i class="bi bi-credit-card me-2"></i>Xác nhận thanh toán
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form id="checkoutForm" class="needs-validation" novalidate>
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div id="selectedProductsList" class="mb-4">
                        <!-- Danh sách sản phẩm sẽ được thêm vào đây bằng JavaScript -->
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="checkoutPhone" class="form-label fw-bold">Số điện thoại <span class="text-danger">*</span></label>
                            <input type="tel" class="form-control" id="checkoutPhone" name="sdtgiaoHang"
                                   placeholder="Nhập số điện thoại nhận hàng" pattern="[0-9]{10,11}" required>
                            <div class="invalid-feedback">
                                Vui lòng nhập số điện thoại hợp lệ (10-11 số).
                            </div>
                        </div>

                        <div class="col-12">
                            <label for="checkoutAddress" class="form-label fw-bold">Địa chỉ giao hàng <span class="text-danger">*</span></label>
                            <textarea class="form-control" id="checkoutAddress" name="diaChiGiaoHang"
                                      rows="3" placeholder="Nhập địa chỉ giao hàng chi tiết..." required></textarea>
                            <div class="invalid-feedback">
                                Vui lòng nhập địa chỉ giao hàng.
                            </div>
                        </div>

                        <div class="col-12">
                            <label for="checkoutNote" class="form-label fw-bold">Ghi chú (tùy chọn)</label>
                            <textarea class="form-control" id="checkoutNote" name="ghiChu"
                                      rows="2" placeholder="Ghi chú thêm cho đơn hàng..."></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary" id="confirmCheckoutBtn">
                        <i class="bi bi-check-circle me-2"></i>Xác nhận đặt hàng
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .table th {
            border-top: none;
            font-weight: 600;
        }

        .product-row:hover {
            background-color: #f8f9fa;
        }

        .table-warning {
            background-color: #fff3cd !important;
        }

        .card {
            border: none;
            border-radius: 12px;
        }

        .btn-group-sm > .btn {
            padding: 0.25rem 0.5rem;
        }

        .product-checkbox:disabled {
            background-color: #e9ecef;
            border-color: #6c757d;
        }

        .was-validated .form-control:invalid {
            border-color: #dc3545;
        }

        .was-validated .form-control:valid {
            border-color: #198754;
        }

        .quantity-controls .btn {
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .quantity-input {
            width: 70px !important;
        }

            .quantity-input:focus {
                border-color: #0d6efd;
                box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.25);
            }
    </style>
}

@section Scripts {
    <script>
        $(function () {
            let selectedProducts = [];
            const shippingFee = 0;

            // Hàm xử lý tăng số lượng
            $(document).on('click', '.quantity-increase', function () {
                const $input = $(this).siblings('.quantity-input');
                const max = parseInt($input.attr('max'));
                let value = parseInt($input.val()) || 1;

                if (value < max) {
                    value++;
                    $input.val(value);
                    updateQuantityButtons($input);
                    updateSelectedProducts();
                }
            });

            // Hàm xử lý giảm số lượng
            $(document).on('click', '.quantity-decrease', function () {
                const $input = $(this).siblings('.quantity-input');
                const min = parseInt($input.attr('min'));
                let value = parseInt($input.val()) || 1;

                if (value > min) {
                    value--;
                    $input.val(value);
                    updateQuantityButtons($input);
                    updateSelectedProducts();
                }
            });

            // Hàm xử lý thay đổi số lượng trực tiếp
            $(document).on('change', '.quantity-input', function () {
                const $input = $(this);
                const min = parseInt($input.attr('min'));
                const max = parseInt($input.attr('max'));
                let value = parseInt($input.val()) || 1;

                // Validate số lượng
                if (value < min) value = min;
                if (value > max) value = max;

                $input.val(value);
                updateQuantityButtons($input);
                updateSelectedProducts();
            });

            // Hàm cập nhật trạng thái nút tăng/giảm
            function updateQuantityButtons($input) {
                const value = parseInt($input.val());
                const min = parseInt($input.attr('min'));
                const max = parseInt($input.attr('max'));

                $input.siblings('.quantity-decrease').prop('disabled', value <= min);
                $input.siblings('.quantity-increase').prop('disabled', value >= max);
            }

            // Cập nhật hàm updateSelectedProducts để tính theo số lượng
            function updateSelectedProducts() {
                selectedProducts = [];
                let subtotal = 0;
                let totalItems = 0;

                $('.product-checkbox:checked').each(function () {
                    const productId = $(this).val();
                    const price = parseFloat($(this).data('price'));
                    const name = $(this).data('name');
                    const image = $(this).data('image');
                    const stock = parseInt($(this).data('stock'));

                    // Lấy số lượng từ input
                    const quantityInput = $(this).closest('tr').find('.quantity-input');
                    const quantity = quantityInput.length ? parseInt(quantityInput.val()) || 1 : 1;

                    selectedProducts.push({
                        id: productId,
                        price: price,
                        name: name,
                        image: image,
                        stock: stock,
                        quantity: quantity
                    });

                    subtotal += price * quantity;
                    totalItems += quantity;
                });

                // Cập nhật UI
                $('#selectedCount').text(totalItems);
                $('#subtotal').text(subtotal.toLocaleString('vi-VN') + ' ₫');

                const total = subtotal + shippingFee;
                $('#totalAmount').text(total.toLocaleString('vi-VN') + ' ₫');

                // Kích hoạt/vô hiệu hóa nút thanh toán
                const canCheckout = selectedProducts.length > 0;
                $('#finalCheckoutBtn').prop('disabled', !canCheckout);
                $('#checkoutSelectedBtn').prop('disabled', !canCheckout);
            }

            // Chọn tất cả
            $('#checkAll').change(function () {
                const isChecked = $(this).prop('checked');
                $('.product-checkbox:not(:disabled)').prop('checked', isChecked);
                updateSelectedProducts();
            });

            // Theo dõi sự thay đổi checkbox
            $(document).on('change', '.product-checkbox', updateSelectedProducts);

            // Nút chọn tất cả
            $('#selectAllBtn').click(function () {
                $('#checkAll').prop('checked', true).trigger('change');
            });

            // Nút bỏ chọn tất cả
            $('#unselectAllBtn').click(function () {
                $('#checkAll').prop('checked', false).trigger('change');
            });

            // Xóa sản phẩm đã chọn
            $('#removeSelectedBtn').click(function () {
                if (selectedProducts.length === 0) {
                    Swal.fire('Thông báo', 'Vui lòng chọn ít nhất một sản phẩm để xóa', 'info');
                    return;
                }

                Swal.fire({
                    title: 'Xác nhận xóa',
                    text: `Bạn có chắc muốn xóa ${selectedProducts.length} sản phẩm khỏi yêu thích?`,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Xóa',
                    cancelButtonText: 'Hủy',
                    confirmButtonColor: '#d33'
                }).then((result) => {
                    if (result.isConfirmed) {
                        const productIds = selectedProducts.map(p => p.id);

                        $.ajax({
                            url: '@Url.Action("RemoveMultipleFromWishlist", "Wishlist")',
                            type: 'POST',
                            data: {
                                productIds: productIds
                            },
                            headers: {
                                'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                            },
                            success: function (response) {
                                if (response.success) {
                                    Swal.fire('Thành công', response.message, 'success').then(() => {
                                        location.reload();
                                    });
                                } else {
                                    Swal.fire('Lỗi', response.message, 'error');
                                }
                            },
                            error: function () {
                                Swal.fire('Lỗi', 'Có lỗi xảy ra khi xóa sản phẩm', 'error');
                            }
                        });
                    }
                });
            });

            // Mở modal thanh toán
            $('#checkoutSelectedBtn, #finalCheckoutBtn').click(function () {
                if (selectedProducts.length === 0) {
                    Swal.fire('Thông báo', 'Vui lòng chọn ít nhất một sản phẩm để thanh toán', 'info');
                    return;
                }

                // Kiểm tra tồn kho
                const outOfStockProducts = selectedProducts.filter(p => p.quantity > p.stock);
                if (outOfStockProducts.length > 0) {
                    const productNames = outOfStockProducts.map(p => p.name).join(', ');
                    Swal.fire('Lỗi', `Số lượng mua vượt quá tồn kho cho sản phẩm: ${productNames}`, 'error');
                    return;
                }

                // Hiển thị danh sách sản phẩm đã chọn trong modal với số lượng
                const productsHtml = selectedProducts.map(product => `
                    <div class="d-flex align-items-center mb-3 p-2 border rounded">
                        <img src="${product.image || '/images/placeholder.png'}"
                             class="rounded me-3" style="width: 50px; height: 50px; object-fit: cover;">
                        <div class="flex-grow-1">
                            <h6 class="mb-1">${product.name}</h6>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="text-danger fw-bold">${product.price.toLocaleString('vi-VN')} ₫</span>
                                <span class="text-muted">Số lượng: ${product.quantity}</span>
                            </div>
                            <small class="text-muted">Thành tiền: ${(product.price * product.quantity).toLocaleString('vi-VN')} ₫</small>
                        </div>
                    </div>
                `).join('');

                $('#selectedProductsList').html(`
                    <h6>Sản phẩm đã chọn (${selectedProducts.reduce((sum, p) => sum + p.quantity, 0)} sản phẩm):</h6>
                    ${productsHtml}
                    <div class="d-flex justify-content-between fw-bold mt-3">
                        <span>Tổng cộng:</span>
                        <span class="text-danger">${(selectedProducts.reduce((sum, p) => sum + (p.price * p.quantity), 0) + shippingFee).toLocaleString('vi-VN')} ₫</span>
                    </div>
                `);

                // Reset form
                $('#checkoutForm')[0].reset();
                $('#checkoutForm').removeClass('was-validated');
                $('#checkoutModal').modal('show');
            });

            // Xử lý thanh toán
            $('#checkoutForm').on('submit', function (e) {
                e.preventDefault();

                const form = $(this);
                form.addClass('was-validated');

                if (!form[0].checkValidity()) {
                    e.stopPropagation();
                    return;
                }

                // Tạo mảng chứa thông tin sản phẩm và số lượng
                const checkoutItems = selectedProducts.map(product => ({
                    productId: product.id,
                    quantity: product.quantity
                }));

                const checkoutData = {
                    items: checkoutItems,
                    sdtgiaoHang: $('#checkoutPhone').val(),
                    diaChiGiaoHang: $('#checkoutAddress').val(),
                    ghiChu: $('#checkoutNote').val()
                };

                // Disable nút xác nhận
                $('#confirmCheckoutBtn').prop('disabled', true)
                    .html('<span class="spinner-border spinner-border-sm me-2"></span>Đang xử lý...');

                // Hiển thị loading
                Swal.fire({
                    title: 'Đang xử lý đơn hàng...',
                    text: 'Vui lòng chờ trong giây lát',
                    allowOutsideClick: false,
                    didOpen: function() {
                        Swal.showLoading();
                    }
                });

                $.ajax({
                    url: '@Url.Action("CheckoutFromWishlist", "Wishlist")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(checkoutData),
                    headers: {
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function (response) {
                        Swal.close();

                        if (response.success) {
                            $('#checkoutModal').modal('hide');
                            Swal.fire({
                                title: 'Thành công!',
                                text: response.message,
                                icon: 'success',
                                confirmButtonText: 'Xem đơn hàng',
                                cancelButtonText: 'Tiếp tục mua sắm',
                                showCancelButton: true,
                                confirmButtonColor: '#3085d6',
                                cancelButtonColor: '#6c757d'
                            }).then((result) => {
                                if (result.isConfirmed) {
                                    window.location.href = response.redirectUrl;
                                } else {
                                    location.reload();
                                }
                            });
                        } else {
                            Swal.fire('Thông báo', response.message, 'warning');
                        }
                    },
                    error: function (xhr, status, error) {
                        Swal.close();
                        console.error('Lỗi thanh toán:', error);
                        Swal.fire('Lỗi', 'Có lỗi xảy ra khi xử lý đơn hàng', 'error');
                    },
                    complete: function () {
                        $('#confirmCheckoutBtn').prop('disabled', false)
                            .html('<i class="bi bi-check-circle me-2"></i>Xác nhận đặt hàng');
                    }
                });
            });

            // Reset form khi modal đóng
            $('#checkoutModal').on('hidden.bs.modal', function () {
                $('#checkoutForm')[0].reset();
                $('#checkoutForm').removeClass('was-validated');
            });

            // Xóa từng sản phẩm (giữ nguyên chức năng cũ)
            $('.remove-wishlist').click(function () {
                var reviewId = $(this).data('reviewid');
                var row = $(this).closest('tr');

                Swal.fire({
                    title: 'Xác nhận',
                    text: 'Bạn có chắc muốn xóa sản phẩm này khỏi yêu thích?',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Xóa',
                    cancelButtonText: 'Hủy',
                    confirmButtonColor: '#d33'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: '@Url.Action("RemoveFromWishlist", "Wishlist")',
                            type: 'POST',
                            data: { reviewId: reviewId },
                            headers: {
                                'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                            },
                            success: function (response) {
                                if (response.success) {
                                    row.fadeOut(300, function() {
                                        $(this).remove();
                                        if ($('tbody tr').length === 0) {
                                            location.reload();
                                        }
                                    });
                                    Swal.fire('Thành công', response.message, 'success');
                                } else {
                                    Swal.fire('Lỗi', response.message, 'error');
                                }
                            },
                            error: function () {
                                Swal.fire('Lỗi', 'Có lỗi xảy ra', 'error');
                            }
                        });
                    }
                });
            });
        });
    </script>
}
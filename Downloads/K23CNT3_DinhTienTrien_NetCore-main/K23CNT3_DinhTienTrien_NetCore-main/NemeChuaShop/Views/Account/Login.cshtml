@model NemeChuaShop.Models.LoginViewModel

@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="container my-5" style="max-width: 450px;">
    <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
        <div class="card-header bg-success text-white text-center py-4">
            <h3 class="fw-bold mb-1"><i class="bi bi-person-circle me-2"></i>Đăng Nhập</h3>
            <p class="mb-0 small text-white-50">Dành cho Khách hàng & Quản trị viên</p>
        </div>
        <div class="card-body p-4 p-md-5">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <form asp-action="Login" method="post" asp-route-returnUrl="@ViewData["ReturnUrl"]">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="UserName" class="form-label fw-semibold"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-person-fill"></i></span>
                        <input asp-for="UserName" class="form-control" placeholder="Email / Tên tài khoản" autofocus />
                    </div>
                    <span asp-validation-for="UserName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label fw-semibold"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-lock-fill"></i></span>
                        <input asp-for="Password" class="form-control" placeholder="Mật khẩu" />
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="mb-3 form-check d-flex justify-content-between align-items-center">
                    <div>
                        <input class="form-check-input" type="checkbox" asp-for="RememberMe" />
                        <label class="form-check-label small" asp-for="RememberMe">Ghi nhớ</label>
                    </div>
                    <a href="javascript:void(0)" class="text-decoration-none small text-muted">Quên mật khẩu?</a>
                </div>

                <div class="d-grid mt-4">
                    <button type="submit" class="btn btn-success btn-lg fw-semibold shadow-sm">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Đăng Nhập
                    </button>
                </div>
            </form>

            <div class="text-center mt-4 pt-3 border-top">
                <span class="text-muted small">Chưa có tài khoản? </span>
                <a asp-action="Register" class="text-success fw-bold text-decoration-none small">Đăng ký ngay</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

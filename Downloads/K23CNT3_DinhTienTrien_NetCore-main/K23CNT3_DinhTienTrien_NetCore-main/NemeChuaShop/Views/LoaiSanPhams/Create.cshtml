@model NemeChuaShop.Models.LoaiSanPham

@{
    ViewData["Title"] = "Thêm Loại Sản Phẩm";
}

<div class="container my-4" style="max-width: 600px;">
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-success text-white py-3">
            <h4 class="mb-0 fw-bold"><i class="bi bi-plus-circle me-2"></i>Thêm Loại Sản Phẩm</h4>
        </div>
        <div class="card-body p-4">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="MaLoai" class="form-label fw-semibold">Mã Loại <span class="text-danger">*</span></label>
                    <input asp-for="MaLoai" class="form-control" placeholder="Ví dụ: L01, NEM_CHUA..." />
                    <span asp-validation-for="MaLoai" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="TenLoai" class="form-label fw-semibold">Tên Loại Sản Phẩm <span class="text-danger">*</span></label>
                    <input asp-for="TenLoai" class="form-control" placeholder="Ví dụ: Nem Chua Rán, Nem Chua Thanh Hóa..." />
                    <span asp-validation-for="TenLoai" class="text-danger small"></span>
                </div>

                <div class="mb-3 form-check form-switch">
                    <input class="form-check-input" type="checkbox" asp-for="TrangThai" />
                    <label class="form-check-label fw-semibold" asp-for="TrangThai">Kích hoạt hoạt động</label>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Quay lại
                    </a>
                    <button type="submit" class="btn btn-success px-4">
                        <i class="bi bi-save"></i> Lưu thông tin
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

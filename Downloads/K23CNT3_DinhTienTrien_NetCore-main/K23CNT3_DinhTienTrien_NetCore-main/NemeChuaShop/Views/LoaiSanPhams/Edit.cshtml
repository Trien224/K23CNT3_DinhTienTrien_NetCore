@model NemeChuaShop.Models.LoaiSanPham

@{
    ViewData["Title"] = "Cập nhật Loại Sản Phẩm";
}

<div class="container my-4" style="max-width: 600px;">
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-warning text-dark py-3">
            <h4 class="mb-0 fw-bold"><i class="bi bi-pencil-square me-2"></i>Cập nhật Loại Sản Phẩm</h4>
        </div>
        <div class="card-body p-4">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="MaLoai" />

                <div class="mb-3">
                    <label class="form-label fw-semibold">Mã Loại</label>
                    <input class="form-control bg-light" value="@Model.MaLoai" disabled />
                    <small class="text-muted">Mã loại không được phép thay đổi để đảm bảo toàn vẹn dữ liệu.</small>
                </div>

                <div class="mb-3">
                    <label asp-for="TenLoai" class="form-label fw-semibold">Tên Loại Sản Phẩm <span class="text-danger">*</span></label>
                    <input asp-for="TenLoai" class="form-control" />
                    <span asp-validation-for="TenLoai" class="text-danger small"></span>
                </div>

                <div class="mb-3 form-check form-switch">
                    <input class="form-check-input" type="checkbox" asp-for="TrangThai" />
                    <label class="form-check-label fw-semibold" asp-for="TrangThai">Kích hoạt hoạt động</label>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Quay lại
                    </a>
                    <button type="submit" class="btn btn-warning px-4 fw-semibold">
                        <i class="bi bi-check2-circle"></i> Cập nhật
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

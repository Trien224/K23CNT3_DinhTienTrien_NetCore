@model IEnumerable<NemeChuaShop.Models.LoaiSanPham>

@{
    ViewData["Title"] = "Danh sách Loại Sản Phẩm";
}

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary fw-bold"><i class="bi bi-tags-fill me-2"></i>Danh sách Loại Sản Phẩm</h2>
        <a class="btn btn-success px-4" asp-action="Create">
            <i class="bi bi-plus-circle me-1"></i> Thêm Loại Mới
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-3">Mã Loại</th>
                            <th>Tên Loại Sản Phẩm</th>
                            <th class="text-center">Số Lượng SP</th>
                            <th class="text-center">Trạng Thái</th>
                            <th>Ngày Cập Nhật</th>
                            <th class="text-center pe-3">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-3 fw-bold text-secondary">@item.MaLoai</td>
                                    <td class="fw-semibold text-dark">@item.TenLoai</td>
                                    <td class="text-center">
                                        <span class="badge bg-info text-dark">@(item.SanPhams?.Count ?? 0) sản phẩm</span>
                                    </td>
                                    <td class="text-center">
                                        @if (item.TrangThai)
                                        {
                                            <span class="badge bg-success">Đang hoạt động</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Tạm ngừng</span>
                                        }
                                    </td>
                                    <td>@(item.NgayCapNhat?.ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
                                    <td class="text-center pe-3">
                                        <div class="btn-group btn-group-sm">
                                            <a class="btn btn-outline-warning" asp-action="Edit" asp-route-id="@item.Id" title="Sửa">
                                                <i class="bi bi-pencil-square"></i> Sửa
                                            </a>
                                            <a class="btn btn-outline-info" asp-action="Details" asp-route-id="@item.Id" title="Chi tiết">
                                                <i class="bi bi-info-circle"></i> Xem
                                            </a>
                                            <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@item.Id" title="Xóa">
                                                <i class="bi bi-trash"></i> Xóa
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">Chưa có loại sản phẩm nào.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

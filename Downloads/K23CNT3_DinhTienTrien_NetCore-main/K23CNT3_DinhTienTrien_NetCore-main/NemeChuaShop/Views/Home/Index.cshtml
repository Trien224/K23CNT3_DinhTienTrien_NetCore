@{
    ViewData["Title"] = "Trang chủ - Cửa hàng Nem Chua";
}

<!-- Danh sách sản phẩm -->
<div class="my-4">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-2">
        <h2 class="fw-bold text-success"><i class="bi bi-fire me-2"></i>Sản Phẩm Nổi Bật</h2>
        <a asp-controller="SanPhams" asp-action="Index" class="btn btn-outline-success btn-sm">
            Xem tất cả <i class="bi bi-arrow-right ms-1"></i>
        </a>
    </div>

    <div id="productList" class="d-flex flex-wrap gap-3 justify-content-start"></div>
</div>

<!-- Popup giỏ hàng -->
<div id="cart" class="cart-popup" style="display: none;">
    <h2>Giỏ hàng</h2>
    <ul id="cartItems"></ul>
    <p id="total">Tổng: 0đ</p>
    <button onclick="checkout()" class="btn btn-success">Thanh toán</button>
</div>

<!-- Gắn script -->
@section Scripts {
    <script src="~/js/shop.js"></script>
}

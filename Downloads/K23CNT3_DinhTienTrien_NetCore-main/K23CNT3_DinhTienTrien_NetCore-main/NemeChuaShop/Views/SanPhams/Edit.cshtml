@model NemeChuaShop.Models.SanPham

@{
    ViewData["Title"] = "Chỉnh sửa Sản Phẩm";
}

<div class="container my-4" style="max-width: 800px;">
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-warning text-dark py-3">
            <h4 class="mb-0 fw-bold"><i class="bi bi-pencil-square me-2"></i>Chỉnh sửa Sản Phẩm</h4>
        </div>
        <div class="card-body p-4">
            <form asp-action="Edit" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="MaSanPham" />
                <input type="hidden" asp-for="HinhAnh" />

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Mã Sản Phẩm</label>
                        <input class="form-control bg-light" value="@Model.MaSanPham" disabled />
                        <small class="text-muted">Mã sản phẩm cố định.</small>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="TenSanPham" class="form-label fw-semibold">Tên Sản Phẩm <span class="text-danger">*</span></label>
                        <input asp-for="TenSanPham" class="form-control" />
                        <span asp-validation-for="TenSanPham" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="MaLoai" class="form-label fw-semibold">Loại Sản Phẩm <span class="text-danger">*</span></label>
                        <select asp-for="MaLoai" class="form-select" asp-items="ViewBag.MaLoai">
                            <option value="">-- Chọn Loại Sản Phẩm --</option>
                        </select>
                        <span asp-validation-for="MaLoai" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="MaNguoiBan" class="form-label fw-semibold">Người Bán (Tùy chọn)</label>
                        <select asp-for="MaNguoiBan" class="form-select" asp-items="ViewBag.MaNguoiBan">
                            <option value="">-- Không chọn / Mặc định --</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="DonGia" class="form-label fw-semibold">Đơn Giá (VNĐ) <span class="text-danger">*</span></label>
                        <input asp-for="DonGia" class="form-control" type="number" min="0" step="1000" />
                        <span asp-validation-for="DonGia" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="SoLuong" class="form-label fw-semibold">Số Lượng Trong Kho <span class="text-danger">*</span></label>
                        <input asp-for="SoLuong" class="form-control" type="number" min="0" />
                        <span asp-validation-for="SoLuong" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-semibold">Thay Đổi Hình Ảnh (Để trống nếu giữ ảnh hiện tại)</label>
                        <input type="file" name="uploadHinhAnh" id="imageInput" class="form-control" accept="image/*" onchange="previewImage(event)" />
                        <div class="mt-3 d-flex align-items-center gap-3">
                            <div>
                                <span class="d-block small text-muted mb-1">Ảnh hiện tại:</span>
                                <img src="~/@(string.IsNullOrEmpty(Model.HinhAnh) ? "images/ban3.png" : Model.HinhAnh)" alt="@Model.TenSanPham" class="img-thumbnail rounded" style="width: 100px; height: 100px; object-fit: cover;" onerror="this.src='/images/ban3.png';" />
                            </div>
                            <div id="previewContainer" style="display: none;">
                                <span class="d-block small text-success fw-bold mb-1">Ảnh mới chọn:</span>
                                <img id="imagePreview" src="#" alt="New Preview" class="img-thumbnail rounded border-success" style="width: 100px; height: 100px; object-fit: cover;" />
                            </div>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="form-check form-switch mt-2">
                            <input class="form-check-input" type="checkbox" asp-for="TrangThai" />
                            <label class="form-check-label fw-semibold" asp-for="TrangThai">Kích hoạt mở bán</label>
                        </div>
                    </div>
                </div>

                <hr class="my-4" />

                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Quay lại
                    </a>
                    <button type="submit" class="btn btn-warning px-4 fw-semibold">
                        <i class="bi bi-check2-circle"></i> Cập Nhật
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        function previewImage(event) {
            const preview = document.getElementById('imagePreview');
            const container = document.getElementById('previewContainer');
            const file = event.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    preview.src = e.target.result;
                    container.style.display = 'block';
                }
                reader.readAsDataURL(file);
            }
        }
    </script>
}

@model IEnumerable<NemeChuaShop.Models.SanPham>

@{
    ViewData["Title"] = "Quản lý Sản Phẩm";
}

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary fw-bold"><i class="bi bi-box-seam-fill me-2"></i>Quản lý Sản Phẩm</h2>
        <div>
            <a class="btn btn-outline-primary me-2" asp-controller="LoaiSanPhams" asp-action="Index">
                <i class="bi bi-tags"></i> Loại Sản Phẩm
            </a>
            <a class="btn btn-success px-3" asp-action="Create">
                <i class="bi bi-plus-circle me-1"></i> Thêm Sản Phẩm Mới
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Bộ lọc & Tìm kiếm -->
    <div class="card shadow-sm border-0 mb-4 bg-light">
        <div class="card-body">
            <form method="get" asp-action="Index" class="row g-3 align-items-center">
                <div class="col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                        <input type="text" name="searchString" value="@ViewBag.CurrentSearch" class="form-control" placeholder="Tìm theo tên hoặc mã sản phẩm..." />
                    </div>
                </div>
                <div class="col-md-4">
                    <select name="maLoai" class="form-select" asp-items="ViewBag.Categories">
                        <option value="">-- Tất cả loại sản phẩm --</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-fill">
                        <i class="bi bi-filter"></i> Lọc
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-clockwise"></i> Reset
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Bảng danh sách sản phẩm -->
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-3 text-center" style="width: 80px;">Hình Ảnh</th>
                            <th>Mã SP</th>
                            <th>Tên Sản Phẩm</th>
                            <th>Loại SP</th>
                            <th class="text-end">Đơn Giá</th>
                            <th class="text-center">Số Lượng</th>
                            <th class="text-center">Trạng Thái</th>
                            <th class="text-center pe-3">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-3 text-center">
                                        @if (!string.IsNullOrEmpty(item.HinhAnh))
                                        {
                                            <img src="~/@item.HinhAnh" alt="@item.TenSanPham" class="rounded border" style="width: 60px; height: 60px; object-fit: cover;" onerror="this.src='/images/ban3.png';" />
                                        }
                                        else
                                        {
                                            <img src="~/images/ban3.png" alt="No image" class="rounded border" style="width: 60px; height: 60px; object-fit: cover;" />
                                        }
                                    </td>
                                    <td class="fw-bold text-secondary">@item.MaSanPham</td>
                                    <td class="fw-semibold text-dark">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none text-dark">@item.TenSanPham</a>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary">@(item.MaLoaiNavigation?.TenLoai ?? item.MaLoai)</span>
                                    </td>
                                    <td class="text-end fw-bold text-danger">
                                        @item.DonGia.ToString("#,##0") đ
                                    </td>
                                    <td class="text-center">
                                        @if (item.SoLuong > 5)
                                        {
                                            <span class="badge bg-light text-dark border">@item.SoLuong</span>
                                        }
                                        else if (item.SoLuong > 0)
                                        {
                                            <span class="badge bg-warning text-dark">Sắp hết (@item.SoLuong)</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Hết hàng</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (item.TrangThai)
                                        {
                                            <span class="badge bg-success">Đang bán</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Tạm ẩn</span>
                                        }
                                    </td>
                                    <td class="text-center pe-3">
                                        <div class="btn-group btn-group-sm">
                                            <a class="btn btn-outline-warning" asp-action="Edit" asp-route-id="@item.Id" title="Sửa">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>
                                            <a class="btn btn-outline-info" asp-action="Details" asp-route-id="@item.Id" title="Xem">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@item.Id" title="Xóa">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                                    Không tìm thấy sản phẩm nào phù hợp.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

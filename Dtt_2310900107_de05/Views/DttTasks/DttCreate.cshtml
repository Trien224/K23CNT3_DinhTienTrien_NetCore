@model Dtt_2310900107_de05.Models.DttTask

@{
    ViewData["Title"] = "Thêm công việc mới";
}

<h1>Thêm công việc mới</h1>

<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="DttCreate">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="DttTaskName" class="form-label">Tên công việc</label>
                <input asp-for="DttTaskName" class="form-control" />
                <span asp-validation-for="DttTaskName" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="DttTaskLevel" class="form-label">Cấp độ</label>
                <input asp-for="DttTaskLevel" class="form-control" />
                <span asp-validation-for="DttTaskLevel" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="DttStartDate" class="form-label">Ngày bắt đầu</label>
                <input asp-for="DttStartDate" class="form-control" type="date" />
                <span asp-validation-for="DttStartDate" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label class="form-label">Trạng thái</label><br />
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="DttTaskStatus" value="true" />
                    <label class="form-check-label">Show</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="DttTaskStatus" value="false" />
                    <label class="form-check-label">Hide</label>
                </div>
                <span asp-validation-for="DttTaskStatus" class="text-danger d-block"></span>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Thêm mới" class="btn btn-success" />
                <a asp-action="DttIndex" class="btn btn-secondary ms-2">Quay lại danh sách</a>
            </div>
        </form>
    </div>
</div>


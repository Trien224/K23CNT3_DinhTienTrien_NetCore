<script>
    // Enhanced Search Functionality
    let searchTimeout;
    let currentSuggestions = [];

    document.addEventListener('DOMContentLoaded', function() {
        const searchInput = document.getElementById('searchInput');
        const suggestionsContainer = document.getElementById('searchSuggestions');

        // Load initial counts
        loadNavbarCounts();

        // Enhanced input handling with debounce
        searchInput.addEventListener('input', function() {
            clearTimeout(searchTimeout);
            const searchTerm = this.value.trim();

            if (searchTerm.length < 2) {
                hideSuggestions();
                return;
            }

            searchTimeout = setTimeout(() => {
                fetchSearchSuggestions(searchTerm);
            }, 250);
        });

        // Focus handling
        searchInput.addEventListener('focus', function() {
            const searchTerm = this.value.trim();
            if (searchTerm.length >= 2 && currentSuggestions.length > 0) {
                showSuggestions();
            }
        });

        // Keyboard navigation
        searchInput.addEventListener('keydown', function(e) {
            if (e.key === 'Enter') {
                performSearch();
                hideSuggestions();
            } else if (e.key === 'Escape') {
                hideSuggestions();
                this.blur();
            }
        });

        // Click outside to hide suggestions
        document.addEventListener('click', function(e) {
            if (!searchInput.contains(e.target) && !suggestionsContainer.contains(e.target)) {
                hideSuggestions();
            }
        });
    });

    // Enhanced navbar counts loading
    async function loadNavbarCounts() {
        try {
            // Load cart count
            const cartResponse = await fetch('/Cart/GetCartCount');
            if (cartResponse.ok) {
                const cartCount = await cartResponse.json();
                document.getElementById('cartCount').textContent = cartCount;
            }

            // Load wishlist count
            const wishlistResponse = await fetch('/Wishlist/GetWishlistCount');
            if (wishlistResponse.ok) {
                const wishlistCount = await wishlistResponse.json();
                document.getElementById('wishlistCount').textContent = wishlistCount;
            }

            // Load order count
            const orderResponse = await fetch('/HoaDon/GetPendingOrderCount');
            if (orderResponse.ok) {
                const orderCount = await orderResponse.json();
                document.getElementById('orderCount').textContent = orderCount;
            }

        } catch (error) {
            console.error('Error loading navbar counts:', error);
        }
    }

    // Enhanced search suggestions
    async function fetchSearchSuggestions(term) {
        try {
            const response = await fetch(`/Home/SearchSuggestions?term=${encodeURIComponent(term)}`);
            if (!response.ok) throw new Error('Network response was not ok');

            const data = await response.json();

            if (data.success && data.suggestions.length > 0) {
                currentSuggestions = data.suggestions;
                displaySuggestions(data.suggestions, term);
            } else {
                currentSuggestions = [];
                displayNoSuggestions();
            }
        } catch (error) {
            console.error('Error fetching search suggestions:', error);
            displayNoSuggestions();
        }
    }

    // Display suggestions with enhanced UI
    function displaySuggestions(suggestions, searchTerm) {
        const suggestionList = document.getElementById('suggestionList');

        if (!suggestions || suggestions.length === 0) {
            displayNoSuggestions();
            return;
        }

        let html = '';
        const limitedSuggestions = suggestions.slice(0, 8);

        limitedSuggestions.forEach((suggestion, index) => {
            const highlightedName = highlightText(suggestion.tenSp, searchTerm);
            const price = formatPrice(suggestion.donGia);

            html += `
                <a href="/Home/Details/${suggestion.maSp}" class="suggestion-item">
                    <img src="${suggestion.anhDaiDien || '/images/placeholder.jpg'}"
                         alt="${suggestion.tenSp}"
                         onerror="this.src='/images/placeholder.jpg'">
                    <div class="suggestion-info">
                        <div class="suggestion-name">${highlightedName}</div>
                        <div class="suggestion-price">${price}</div>
                    </div>
                    <i class="bi bi-arrow-right-short text-muted"></i>
                </a>
            `;
        });

        suggestionList.innerHTML = html;
        showSuggestions();
    }

    function displayNoSuggestions() {
        const suggestionList = document.getElementById('suggestionList');
        suggestionList.innerHTML = `
            <div class="no-suggestions">
                <i class="bi bi-search display-4 text-muted mb-3"></i>
                <div>Không tìm thấy sản phẩm phù hợp</div>
                <small class="text-muted">Thử với từ khóa khác</small>
            </div>
        `;
        showSuggestions();
    }

    function highlightText(text, searchTerm) {
        if (!searchTerm) return text;

        const regex = new RegExp(`(${searchTerm})`, 'gi');
        return text.replace(regex, '<span class="search-highlight">$1</span>');
    }

    function formatPrice(price) {
        return new Intl.NumberFormat('vi-VN', {
            style: 'currency',
            currency: 'VND'
        }).format(price);
    }

    function showSuggestions() {
        const suggestionsContainer = document.getElementById('searchSuggestions');
        suggestionsContainer.classList.add('show');
    }

    function hideSuggestions() {
        const suggestionsContainer = document.getElementById('searchSuggestions');
        suggestionsContainer.classList.remove('show');
    }

    function performSearch() {
        const searchTerm = document.getElementById('searchInput').value.trim();

        if (searchTerm) {
            window.location.href = `/Home/Search?q=${encodeURIComponent(searchTerm)}`;
        } else {
            window.location.href = '/Home/Index';
        }

        hideSuggestions();
    }

    // Add Enter key support
    document.getElementById('searchInput').addEventListener('keypress', function(e) {
        if (e.key === 'Enter') {
            performSearch();
        }
    });
</script>
<!-- Modern Banner with Swiper -->
<div class="banner-section position-relative overflow-hidden">
    <div class="swiper bannerSwiper">
        <div class="swiper-wrapper">
            <div class="swiper-slide">
                <div class="banner-slide position-relative">
                    <img src="~/images/ban0.jpg" class="banner-image" alt="Banner 1" />
                    <div class="banner-overlay"></div>
                    <div class="banner-content">
                        <h2 class="banner-title">Sản Phẩm Chất Lượng</h2>
                        <p class="banner-text">Khám phá bộ sưu tập mới nhất</p>
                        <button class="btn btn-primary banner-btn">Mua Ngay</button>
                    </div>
                </div>
            </div>
            <div class="swiper-slide">
                <div class="banner-slide position-relative">
                    <img src="~/images/ban2.jpg" class="banner-image" alt="Banner 2" />
                    <div class="banner-overlay"></div>
                    <div class="banner-content">
                        <h2 class="banner-title">Ưu Đãi Đặc Biệt</h2>
                        <p class="banner-text">Giảm giá lên đến 50%</p>
                        <button class="btn btn-primary banner-btn">Khám Phá</button>
                    </div>
                </div>
            </div>
            <div class="swiper-slide">
                <div class="banner-slide position-relative">
                    <img src="~/images/ban1.jpg" class="banner-image" alt="Banner 3" />
                    <div class="banner-overlay"></div>
                    <div class="banner-content">
                        <h2 class="banner-title">Mới Ra Mắt</h2>
                        <p class="banner-text">Sản phẩm độc quyền</p>
                        <button class="btn btn-primary banner-btn">Xem Ngay</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Navigation -->
        <div class="swiper-button-next"></div>
        <div class="swiper-button-prev"></div>

        <!-- Pagination -->
        <div class="swiper-pagination"></div>
    </div>
</div>

<style>
    .banner-section {
        height: 500px;
        border-radius: 0 0 30px 30px;
        overflow: hidden;
        box-shadow: 0 10px 50px rgba(0,0,0,0.1);
        margin-bottom: 2rem;
    }

    .bannerSwiper {
        width: 100%;
        height: 100%;
    }

    .banner-slide {
        width: 100%;
        height: 100%;
        position: relative;
    }

    .banner-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
    }

    .banner-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(135deg, rgba(0,0,0,0.4) 0%, rgba(0,0,0,0.1) 100%);
    }

    .banner-content {
        position: absolute;
        top: 50%;
        left: 10%;
        transform: translateY(-50%);
        color: white;
        z-index: 2;
        max-width: 500px;
    }

    .banner-title {
        font-size: 3rem;
        font-weight: 700;
        margin-bottom: 1rem;
        text-shadow: 2px 2px 4px rgba(0,0,0,0.5);
        font-family: 'Inter', sans-serif;
        opacity: 0;
        transform: translateY(30px);
        transition: all 0.8s ease;
    }

    .banner-text {
        font-size: 1.3rem;
        margin-bottom: 2rem;
        opacity: 0.9;
        font-weight: 400;
        opacity: 0;
        transform: translateY(30px);
        transition: all 0.8s ease 0.2s;
    }

    .banner-btn {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
        padding: 1rem 2.5rem;
        border-radius: 50px;
        font-weight: 600;
        font-size: 1.1rem;
        transition: all 0.3s ease;
        box-shadow: 0 10px 30px rgba(102, 126, 234, 0.3);
        opacity: 0;
        transform: translateY(30px);
        transition: all 0.8s ease 0.4s;
    }

        .banner-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 40px rgba(102, 126, 234, 0.4);
        }

    /* Active slide animations */
    .swiper-slide-active .banner-title,
    .swiper-slide-active .banner-text,
    .swiper-slide-active .banner-btn {
        opacity: 1;
        transform: translateY(0);
    }

    .swiper-button-next,
    .swiper-button-prev {
        color: white;
        background: rgba(255,255,255,0.2);
        width: 60px;
        height: 60px;
        border-radius: 50%;
        backdrop-filter: blur(10px);
        transition: all 0.3s ease;
    }

        .swiper-button-next:after,
        .swiper-button-prev:after {
            font-size: 1.5rem;
            font-weight: bold;
        }

        .swiper-button-next:hover,
        .swiper-button-prev:hover {
            background: rgba(255,255,255,0.3);
            transform: scale(1.1);
        }

    .swiper-pagination-bullet {
        width: 12px;
        height: 12px;
        background: rgba(255,255,255,0.5);
        opacity: 1;
    }

    .swiper-pagination-bullet-active {
        background: white;
        transform: scale(1.2);
    }

    @@media (max-width: 768px) {
        .banner-section {
            height: 400px;
            border-radius: 0 0 20px 20px;
        }

        .banner-title {
            font-size: 2rem;
        }

        .banner-text {
            font-size: 1rem;
        }

        .banner-content {
            left: 5%;
            right: 5%;
            text-align: center;
        }

        .swiper-button-next,
        .swiper-button-prev {
            width: 40px;
            height: 40px;
        }

            .swiper-button-next:after,
            .swiper-button-prev:after {
                font-size: 1rem;
            }
    }

    @@media (max-width: 576px) {
        .banner-section {
            height: 300px;
        }

        .banner-title {
            font-size: 1.5rem;
        }

        .banner-text {
            font-size: 0.9rem;
            margin-bottom: 1.5rem;
        }

        .banner-btn {
            padding: 0.75rem 2rem;
            font-size: 1rem;
        }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const swiper = new Swiper('.bannerSwiper', {
            loop: true,
            speed: 1000,
            effect: 'fade',
            fadeEffect: {
                crossFade: true
            },
            autoplay: {
                delay: 5000,
                disableOnInteraction: false,
            },
            navigation: {
                nextEl: '.swiper-button-next',
                prevEl: '.swiper-button-prev',
            },
            pagination: {
                el: '.swiper-pagination',
                clickable: true,
                dynamicBullets: true,
            },
            on: {
                init: function() {
                    // Trigger animations for initial slide
                    const activeSlide = this.slides[this.activeIndex];
                    animateSlide(activeSlide);
                },
                slideChangeTransitionStart: function() {
                    // Reset animations for outgoing slide
                    const outgoingSlide = this.slides[this.previousIndex];
                    resetSlide(outgoingSlide);
                },
                slideChangeTransitionEnd: function() {
                    // Trigger animations for incoming slide
                    const incomingSlide = this.slides[this.activeIndex];
                    animateSlide(incomingSlide);
                }
            }
        });

        function animateSlide(slide) {
            const title = slide.querySelector('.banner-title');
            const text = slide.querySelector('.banner-text');
            const btn = slide.querySelector('.banner-btn');

            if (title) {
                title.style.opacity = '1';
                title.style.transform = 'translateY(0)';
            }
            if (text) {
                text.style.opacity = '1';
                text.style.transform = 'translateY(0)';
            }
            if (btn) {
                btn.style.opacity = '1';
                btn.style.transform = 'translateY(0)';
            }
        }

        function resetSlide(slide) {
            const title = slide.querySelector('.banner-title');
            const text = slide.querySelector('.banner-text');
            const btn = slide.querySelector('.banner-btn');

            if (title) {
                title.style.opacity = '0';
                title.style.transform = 'translateY(30px)';
            }
            if (text) {
                text.style.opacity = '0';
                text.style.transform = 'translateY(30px)';
            }
            if (btn) {
                btn.style.opacity = '0';
                btn.style.transform = 'translateY(30px)';
            }
        }

        // Pause autoplay on hover
        const swiperContainer = document.querySelector('.bannerSwiper');
        swiperContainer.addEventListener('mouseenter', () => {
            swiper.autoplay.stop();
        });

        swiperContainer.addEventListener('mouseleave', () => {
            swiper.autoplay.start();
        });

        // Banner button click handlers
        document.querySelectorAll('.banner-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                const slideText = this.closest('.banner-content').querySelector('.banner-text').textContent;
                if (slideText.includes('50%')) {
                    window.location.href = '/Home/Sale';
                } else {
                    window.location.href = '/Home';
                }
            });
        });
    });
</script>
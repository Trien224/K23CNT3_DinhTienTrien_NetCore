@model IEnumerable<NemeShop.Models.SanPham>

@if (Model != null && Model.Any())
{
    <div class="modern-product-grid">
        <div class="row g-4">
            @foreach (var sp in Model)
            {
                <div class="col-xl-3 col-lg-4 col-md-6 col-sm-6">
                    <div class="product-card-wrapper animate-on-scroll" data-aos="fade-up" data-aos-delay="@(Array.IndexOf(Model.ToArray(), sp) * 100)">
                        @await Html.PartialAsync("_ProductCard", sp)
                    </div>
                </div>
            }
        </div>
    </div>
}
else
{
    <div class="empty-state text-center py-5">
        <div class="empty-icon mb-4">
            <i class="bi bi-search display-1 text-muted"></i>
        </div>
        <h4 class="empty-title text-muted mb-3">Không tìm thấy sản phẩm nào</h4>
        <p class="empty-text text-muted mb-4">Hãy thử tìm kiếm với từ khóa khác hoặc duyệt danh mục khác</p>
        <div class="empty-actions">
            <a href="/Home" class="btn btn-primary me-2">
                <i class="bi bi-house me-2"></i>Về trang chủ
            </a>
            <button class="btn btn-outline-secondary" onclick="clearSearch()">
                <i class="bi bi-arrow-clockwise me-2"></i>Xóa bộ lọc
            </button>
        </div>
    </div>
}

<style>
    .modern-product-grid {
        margin: 2rem 0;
    }

    .product-card-wrapper {
        margin-bottom: 1.5rem;
        transition: all 0.3s ease;
    }

        .product-card-wrapper:hover {
            transform: translateY(-5px);
        }

    .empty-state {
        background: var(--surface-color);
        border-radius: var(--border-radius-lg);
        padding: 4rem 2rem;
        margin: 2rem 0;
        border: 2px dashed var(--gray-300);
    }

    .empty-icon {
        opacity: 0.5;
    }

    .empty-title {
        font-weight: 600;
        font-size: 1.5rem;
    }

    .empty-text {
        font-size: 1rem;
        max-width: 400px;
        margin: 0 auto;
    }

    .empty-actions {
        margin-top: 2rem;
    }

    @@media (max-width: 768px) {
        .modern-product-grid .row {
            margin: 0 -0.5rem;
        }

        .modern-product-grid .col-sm-6 {
            padding: 0 0.5rem;
        }

        .empty-state {
            padding: 3rem 1rem;
            margin: 1rem 0;
        }

        .empty-title {
            font-size: 1.25rem;
        }

        .empty-text {
            font-size: 0.9rem;
        }
    }

    @@media (max-width: 576px) {
        .empty-state {
            padding: 2rem 1rem;
        }

        .empty-actions {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

            .empty-actions .btn {
                width: 100%;
                justify-content: center;
            }
    }
</style>

<script>
    function clearSearch() {
        // Clear search input
        const searchInput = document.getElementById('searchInput');
        if (searchInput) {
            searchInput.value = '';
        }

        // Clear filters
        const filters = document.querySelectorAll('select, input[type="number"]');
        filters.forEach(filter => {
            if (filter.tagName === 'SELECT') {
                filter.selectedIndex = 0;
            } else {
                filter.value = '';
            }
        });

        // Trigger search
        if (window.performSearch) {
            window.performSearch();
        } else {
            window.location.href = '/Home';
        }
    }

    // Initialize AOS animations
    document.addEventListener('DOMContentLoaded', function() {
        // Load AOS library if not already loaded
        if (typeof AOS === 'undefined') {
            const script = document.createElement('script');
            script.src = 'https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.js';
            script.onload = function() {
                AOS.init({
                    duration: 600,
                    easing: 'ease-out-cubic',
                    once: true,
                    offset: 50
                });
            };
            document.head.appendChild(script);

            const link = document.createElement('link');
            link.rel = 'stylesheet';
            link.href = 'https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.css';
            document.head.appendChild(link);
        } else {
            AOS.refresh();
        }
    });
</script>
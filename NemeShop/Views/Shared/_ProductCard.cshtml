@model NemeShop.Models.SanPham
@using NemeShop.Extensions
@{
    var isLoggedIn = Context.Session.GetInt32("MaKh") != null;
    var isInWishlist = false;

    // Tính toán trực tiếp trong view
    var giaSauGiam = Model.PhanTramGiam > 0 ? Model.DonGia * (1 - Model.PhanTramGiam / 100) : Model.DonGia;
    var dangGiamGia = Model.PhanTramGiam > 0;
    var tietKiem = Model.DonGia - giaSauGiam;
}

<div class="product-card modern-product-card" data-product-id="@Model.MaSp">
    <div class="product-badges">
        @if (Model.SoLuong <= 0)
        {
            <span class="badge bg-danger">Hết hàng</span>
        }
        else if (dangGiamGia)
        {
            <span class="badge bg-danger">Giảm @Model.PhanTramGiam%</span>
        }
        else if (Model.DonGia < 100000)
        {
            <span class="badge bg-success">Giá tốt</span>
        }
    </div>

    <div class="card-img-container">
        <div class="card-img">
            <img loading="lazy"
                 src="@(string.IsNullOrEmpty(Model.HinhAnh) ? "/images/placeholder.png" : Model.HinhAnh)"
                 alt="@Model.TenSp"
                 class="product-image" />
            <div class="product-overlay">
                <a href="@Url.Action("Details", "Home", new { id = Model.MaSp })" class="btn btn-sm btn-icon" title="Xem nhanh">
                    <i class="bi bi-eye"></i>
                </a>
                <button type="button" class="btn btn-sm btn-icon wishlist-btn @(isInWishlist ? "wishlist-active" : "")"
                        data-product-id="@Model.MaSp"
                        title="@(isInWishlist ? "Xóa khỏi yêu thích" : "Thêm vào yêu thích")">
                    <i class="bi @(isInWishlist ? "bi-heart-fill" : "bi-heart")"></i>
                </button>
            </div>
        </div>
    </div>

    <div class="card-body">
        <div class="product-category small text-muted mb-1">@Model.MaLoaiNavigation?.TenLoai</div>
        <h3 class="product-name">@Model.TenSp</h3>

        <div class="product-pricing">
            @if (dangGiamGia)
            {
                <div class="d-flex align-items-center gap-2">
                    <span class="product-price-old text-muted text-decoration-line-through">
                        @String.Format("{0:N0} ₫", Model.DonGia)
                    </span>
                    <span class="product-price-new text-danger fw-bold">
                        @String.Format("{0:N0} ₫", giaSauGiam)
                    </span>
                </div>
                <div class="product-discount-percent small text-success">
                    Tiết kiệm @String.Format("{0:N0} ₫", tietKiem)
                </div>
            }
            else
            {
                <div class="product-price-normal text-danger fw-bold">
                    @String.Format("{0:N0} ₫", Model.DonGia)
                </div>
            }
        </div>

        <div class="d-flex justify-content-between align-items-center mt-2">
            <div class="product-actions">
                <a href="@Url.Action("Details", "Home", new { id = Model.MaSp })"
                   class="btn btn-sm btn-outline-primary">Xem chi tiết</a>
            </div>

            <button type="button" class="btn btn-sm btn-icon wishlist-btn @(isInWishlist ? "wishlist-active" : "")"
                    data-product-id="@Model.MaSp"
                    title="@(isInWishlist ? "Xóa khỏi yêu thích" : "Thêm vào yêu thích")">
                <i class="bi @(isInWishlist ? "bi-heart-fill" : "bi-heart")"></i>
            </button>
        </div>

        <div class="product-stock mt-2">
            <div class="progress" style="height: 4px;">
                @{
                    var stockPercent = Model.SoLuong > 10 ? 100 : Model.SoLuong * 10;
                }
                <div class="progress-bar @(Model.SoLuong > 5 ? "bg-success" : "bg-warning")"
                     role="progressbar" style="width: @stockPercent%;"></div>
            </div>
            <small class="text-muted">@(Model.SoLuong > 0 ? $"{Model.SoLuong} sản phẩm có sẵn" : "Hết hàng")</small>
        </div>
    </div>
</div>

<style>
    .modern-product-card {
        background: var(--surface-color);
        border-radius: var(--border-radius-lg);
        overflow: hidden;
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--gray-200);
        transition: var(--transition);
        height: 100%;
        display: flex;
        flex-direction: column;
        position: relative;
    }

        .modern-product-card:hover {
            transform: translateY(-8px);
            box-shadow: var(--shadow-xl);
            border-color: var(--primary-light);
        }

    .product-badges {
        position: absolute;
        top: 12px;
        left: 12px;
        z-index: 2;
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .badge {
        font-size: 0.7rem;
        padding: 0.35em 0.65em;
        border-radius: 6px;
        font-weight: 600;
    }

    /* Fixed image container */
    .card-img-container {
        position: relative;
        overflow: hidden;
        background: var(--gray-100);
        padding: 1rem;
    }

    .card-img {
        position: relative;
        width: 100%;
        height: 200px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: white;
        border-radius: var(--border-radius);
        overflow: hidden;
    }

    .product-image {
        max-width: 100%;
        max-height: 100%;
        width: auto;
        height: auto;
        object-fit: contain;
        transition: transform 0.5s ease;
    }

    .modern-product-card:hover .product-image {
        transform: scale(1.05);
    }

    .product-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.3);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .modern-product-card:hover .product-overlay {
        opacity: 1;
    }

    .btn-icon {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: white;
        color: #333;
        border: none;
        transition: all 0.3s;
        cursor: pointer;
        box-shadow: var(--shadow);
    }

        .btn-icon:hover {
            background: var(--primary-color);
            color: white;
            transform: scale(1.1);
        }

    .wishlist-btn.wishlist-active {
        background: var(--primary-color);
        color: white;
    }

        .wishlist-btn.wishlist-active i {
            color: #dc3545 !important;
        }

    .card-body {
        padding: 1.25rem;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
    }

    .product-name {
        font-size: 1rem;
        font-weight: 600;
        margin-bottom: 0.5rem;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        min-height: 48px;
        color: var(--text-color);
        line-height: 1.4;
    }

    .product-pricing {
        margin: 0.75rem 0;
    }

    .product-price-old {
        font-size: 0.85rem;
    }

    .product-price-new {
        font-size: 1.1rem;
    }

    .product-price-normal {
        font-size: 1.1rem;
    }

    .product-discount-percent {
        font-size: 0.8rem;
        margin-top: 2px;
    }

    .product-actions {
        display: flex;
        gap: 0.5rem;
        flex-grow: 1;
    }

    .btn-outline-primary {
        border: 1px solid var(--primary-color);
        color: var(--primary-color);
        transition: all 0.3s ease;
    }

        .btn-outline-primary:hover {
            background: var(--primary-color);
            color: white;
            transform: translateY(-1px);
        }

    .product-stock {
        margin-top: auto;
    }

    .progress {
        background: var(--gray-200);
        border-radius: 2px;
    }

    .progress-bar {
        border-radius: 2px;
        transition: width 0.6s ease;
    }

    /* Responsive adjustments */
    @@media (max-width: 768px) {
        .modern-product-card {
            border-radius: 12px;
        }

        .card-body {
            padding: 1rem;
        }

        .product-name {
            font-size: 0.9rem;
            min-height: 40px;
        }

        .product-price-new,
        .product-price-normal {
            font-size: 1rem;
        }

        .card-img {
            height: 160px;
        }

        .card-img-container {
            padding: 0.75rem;
        }
    }

    @@media (max-width: 576px) {
        .card-img {
            height: 140px;
        }

        .product-actions {
            flex-direction: column;
        }

        .btn-sm {
            padding: 0.375rem 0.75rem;
            font-size: 0.8rem;
        }
    }
</style>